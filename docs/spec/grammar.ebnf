(* toke v0.4 Formal Grammar — EBNF *)
(* Normative per toke-spec-v0.3.md §10 as amended by toke-spec-v0.4.md. *)
(* Matches the reference compiler (toke src/parser.c) as of 2026-07-03. *)
(*                                                                        *)
(* Notation:                                                              *)
(*   =   definition          ;   termination                              *)
(*   |   alternation         ( ) grouping                                 *)
(*   [ ] optional (0 or 1)   { } repetition (0 or more)                  *)
(*                                                                        *)
(* Terminals: single-quoted strings are keywords/symbols; UPPER_CASE      *)
(* names are token classes produced by the lexer.                         *)
(*                                                                        *)
(* Semicolon elision: the trailing semicolon of the last statement        *)
(* before a closing '}' or EOF may be omitted. In the grammar below,     *)
(* every Stmt and Decl is written with a terminating ';', but the         *)
(* compiler silently accepts its absence in that position.                *)
(*                                                                        *)
(* Keywords (14): m i t f let if el lp br rt as mt sc mut                *)
(* (v0.4 §A: 14 keywords; `mut` and `sc` are keywords; `&&`/`||` and the *)
(* two-char operators `== != <= >=` are lexical, not keywords.)          *)


(* ================================================================== *)
(* Top-level structure                                                 *)
(* ================================================================== *)

SourceFile   = ModuleDecl { ImportDecl } { TypeDecl } { ConstDecl }
               { FuncDecl } EOF ;


(* ================================================================== *)
(* Module                                                              *)
(* ================================================================== *)

ModuleDecl   = 'm' '=' ModulePath ';' ;
ModulePath   = IDENT { '.' IDENT } ;


(* ================================================================== *)
(* Imports                                                             *)
(* ================================================================== *)

ImportDecl   = 'i' '=' IDENT ':' ModulePath ';' ;


(* ================================================================== *)
(* Type declarations                                                   *)
(* ================================================================== *)

TypeDecl     = 't' '=' '$' TypeName '{' FieldList '}' ';' ;
TypeName     = IDENT ;
FieldList    = Field { ';' Field } ;
Field        = IDENT ':' TypeExpr ;


(* ================================================================== *)
(* Constant declarations                                               *)
(* ================================================================== *)

ConstDecl    = IDENT '=' LiteralExpr ':' TypeExpr ';' ;


(* ================================================================== *)
(* Function declarations                                               *)
(* ================================================================== *)

FuncDecl     = 'f' '=' IDENT '(' [ ParamList ] ')' ':' ReturnSpec
               '{' StmtList '}' ';' ;
ParamList    = Param { ';' Param } ;
Param        = IDENT ':' TypeExpr ;
ReturnSpec   = TypeExpr [ '!' TypeExpr ] ;


(* ================================================================== *)
(* Statements                                                          *)
(* ================================================================== *)

StmtList     = { Stmt } ;

Stmt         = BindStmt
             | MutBindStmt
             | AssignStmt
             | ReturnStmt
             | IfStmt
             | LoopStmt
             | BreakStmt
             | ArenaStmt
             | ExprStmt
             ;

BindStmt     = 'let' IDENT '=' Expr ';' ;
MutBindStmt  = 'let' IDENT '=' 'mut' '.' Expr ';' ;
AssignStmt   = IDENT '=' Expr ';' ;
ReturnStmt   = ( '<' | 'rt' ) Expr ';' ;
BreakStmt    = 'br' ';' ;

IfStmt       = 'if' '(' Expr ')' '{' StmtList '}' [ 'el' '{' StmtList '}' ] ;
LoopStmt     = 'lp' '(' Stmt Expr ';' Stmt ')' '{' StmtList '}' ;
ArenaStmt    = '{' 'arena' StmtList '}' ;

ExprStmt     = Expr ';' ;


(* ================================================================== *)
(* Expressions — precedence from lowest to highest                     *)
(* ================================================================== *)
(*                                                                        *)
(* Precedence chain (no bitwise operators):                               *)
(*   Expr → IfExpr | MatchExpr | LogOrExpr                                *)
(*   LogOrExpr → LogAndExpr → EqExpr → CompareExpr → AddExpr → MulExpr   *)
(*   → UnaryExpr → PropagateExpr → CallExpr → PostfixExpr → PrimaryExpr   *)

(* A1: `if` and `mt` are keyword-led expression forms, resolved before the      *)
(* binary chain (single-token lookahead on the leading keyword). The grammar    *)
(* as a whole is NOT strict LL(1): it is backtrack-free with a small, closed set *)
(* of deterministic bounded (≤3-token) disambiguations — see Appendix A and     *)
(* toke-spec-v0.4.md §E, which retire the earlier "strict LL(1)" claim.         *)
(* Both yield a value: an if-expression yields the tail expression of the taken *)
(* block; a match yields the taken arm's value. The `if` expression form        *)
(* REQUIRES `el` (a value on every path); the statement form (IfStmt) does not. *)
Expr         = IfExpr | MatchExpr | LogOrExpr ;

IfExpr       = 'if' '(' Expr ')' Block ( 'el' IfExpr | 'el' Block ) ;
Block        = '{' StmtList '}' ;

LogOrExpr    = LogAndExpr { '||' LogAndExpr } ;

LogAndExpr   = EqExpr { '&&' EqExpr } ;

(* A3: '==' is equality; '=' is assignment/binding only (BindStmt/AssignStmt/
   decls/ConstDecl/LoopInit). A bare '=' in expression position is an error. *)
EqExpr       = CompareExpr [ ( '==' | '!=' ) CompareExpr ] ;

CompareExpr  = AddExpr [ ( '<' | '>' | '<=' | '>=' ) AddExpr ] ;

AddExpr      = MulExpr { ( '+' | '-' ) MulExpr } ;

MulExpr      = UnaryExpr { ( '*' | '/' | '%' ) UnaryExpr } ;

UnaryExpr    = '-' UnaryExpr
             | '!' UnaryExpr
             | PropagateExpr
             ;

MatchExpr    = 'mt' LogOrExpr '{' MatchArmList '}' ;

PropagateExpr = CallExpr [ '!' TypeExpr ] ;

CallExpr     = PostfixExpr { '(' [ ArgList ] ')' } ;

PostfixExpr  = PrimaryExpr { '.' IDENT } ;

PrimaryExpr  = IDENT
             | LiteralExpr
             | '(' Expr ')'
             | StructLit
             | ArrayLit
             | MapLit
             | FuncRef
             ;


(* ================================================================== *)
(* Match arms                                                          *)
(* ================================================================== *)

MatchArmList = MatchArm { ';' MatchArm } ;
MatchArm     = TypeExpr ':' IDENT Expr ;


(* ================================================================== *)
(* Struct, array, and map literals                                     *)
(* ================================================================== *)

StructLit    = '$' IDENT '{' FieldInit { ';' FieldInit } '}' ;
FieldInit    = IDENT ':' Expr ;

ArrayLit     = '@' '(' [ Expr { ';' Expr } ] ')' ;

MapLit       = '@' '(' Expr ':' Expr { ';' Expr ':' Expr } ')' ;


(* ================================================================== *)
(* Function references                                                 *)
(* ================================================================== *)

FuncRef      = '&' IDENT ;


(* ================================================================== *)
(* Argument list                                                       *)
(* ================================================================== *)

ArgList      = Expr { ';' Expr } ;


(* ================================================================== *)
(* Type expressions                                                    *)
(* ================================================================== *)

TypeExpr     = ScalarType
             | '$' IDENT
             | ArrayTypeExpr
             | MapTypeExpr
             | FuncTypeExpr
             ;

ScalarType   = 'u8'  | 'u16' | 'u32' | 'u64'
             | 'i8'  | 'i16' | 'i32' | 'i64'
             | 'f32' | 'f64'
             | 'bool'
             | 'str'
             | 'byte'
             ;

ArrayTypeExpr = '@' TypeExpr ;

MapTypeExpr  = '@' '(' TypeExpr ':' TypeExpr ')' ;

FuncTypeExpr = '(' TypeExpr { ';' TypeExpr } ')' ':' TypeExpr ;


(* ================================================================== *)
(* Literals                                                            *)
(* ================================================================== *)

LiteralExpr  = INT_LIT | FLOAT_LIT | STR_LIT | BOOL_LIT ;


(* ================================================================== *)
(* Token classes (produced by the lexer)                               *)
(* ================================================================== *)
(* IDENT       — identifier                     [a-z][a-zA-Z0-9_]*   *)
(* INT_LIT     — decimal integer literal        [0-9]+                *)
(* FLOAT_LIT   — decimal float literal          [0-9]+ '.' [0-9]+    *)
(* STR_LIT     — double-quoted string literal   '"' ... '"'           *)
(* BOOL_LIT    — boolean literal                'true' | 'false'      *)
(* EOF         — end of input                                         *)


(* ================================================================== *)
(* Appendix A — Grammar class, FIRST sets & lookahead (116.5 / A5)     *)
(* ================================================================== *)
(*                                                                        *)
(* Honest characterisation (supersedes the never-written "Appendix X"     *)
(* promised in toke-spec-v0.3.md §10): the reference parser (src/parser.c) *)
(* is **backtrack-free** — it never saves and restores its token position *)
(* (the two former `.get` rewinds were removed in A4/116.4, the unbounded *)
(* loop-init forward scan in A3/116.3). It is **LL(1) at all decision      *)
(* points except a small, closed set of DETERMINISTIC bounded-lookahead   *)
(* (≤3-token) disambiguations** listed below. No decision requires        *)
(* semantic feedback or arbitrary lookahead. This makes the grammar        *)
(* suitable for grammar-constrained decoding (see docs/spec/toke.gbnf).    *)
(*                                                                        *)
(* Single-token FIRST sets at the principal choice points:                *)
(*                                                                        *)
(*   Stmt        FIRST: let→Bind/MutBind ; '<'|rt→Return ; br→Break ;      *)
(*               if→IfStmt ; lp→LoopStmt ; '{'→Arena ; IDENT→Assign|Expr ; *)
(*               '$'|'@'|'&'|'('|'-'|'!'|mt|LITERAL→ExprStmt.              *)
(*   Expr        FIRST: if→IfExpr ; mt→MatchExpr ; else→LogOrExpr.         *)
(*   PrimaryExpr FIRST: IDENT→ident|call ; '$'→StructLit ; '@'→Array|Map ; *)
(*               '&'→FuncRef ; '('→paren ; LITERAL→literal.               *)
(*   TypeExpr    FIRST: u8..f64|bool|str|byte→Scalar ; '$'→named ;         *)
(*               '@'→Array|Map ; '('→FuncType.                            *)
(*   UnaryExpr   FIRST: '-'|'!'→unary ; else→PropagateExpr.               *)
(*                                                                        *)
(* The bounded-lookahead exceptions (all deterministic, no backtracking):  *)
(*                                                                        *)
(*   (E1) Declaration head vs statement: a leading IDENT is a top-level    *)
(*        decl (m=/i=/t=/f=, or a ConstDecl NAME=lit:type) vs an           *)
(*        Assign/Expr statement — resolved by IDENT followed by '='        *)
(*        (2-token). Since A3 made '=' assignment-only, `IDENT '='` is      *)
(*        unambiguous (parser.c is_decl_ident / AssignStmt peek).          *)
(*   (E2) ArenaStmt: '{' 'arena' — a block that opens with the `arena`     *)
(*        identifier (2-token) vs an ordinary '{'.                         *)
(*   (E3) 3-clause LoopStmt vs while-LoopStmt: a leading `let IDENT '='`   *)
(*        or `IDENT '='` inside `lp(` is a 3-clause init (fixed 3-token);   *)
(*        anything else (incl. a while-guard `x==5`) is the while form.     *)
(*   (E4) ArrayLit vs MapLit: `@( E ...` is a MapLit iff the first element  *)
(*        is `E ':' ...` (a ':' at paren-depth 1), else an ArrayLit.        *)
(*   (E5) Cross-module type reference `IDENT '.' '$' TypeName` (3-token,     *)
(*        parser.c:410); function reference `'&' IDENT` (2-token, :510);     *)
(*        closure `IDENT '(' ... 'fn'` (:527); `'mut' IDENT` (:1285).       *)
(*                                                                        *)
(* FOLLOW is governed by the universal separators: every list (params,     *)
(* args, fields, array/map elements, match arms, StmtList) uses ';' as the *)
(* separator and a matching ')'/'}'/']' as the terminator, and the         *)
(* trailing ';' before a closing '}'/EOF is elidable (see §Semicolon       *)
(* elision). A conformance harness (scripts/grammar_check.py) confirms the  *)
(* reference corpus (conform + standalone + examples) is accepted.         *)
