# toke v0.4 -- GBNF tuned for XGrammar (story 131.141).
#
# GENERATED from docs/spec/toke.gbnf by scripts/gbnf_tune.py -- do not edit.
# Edit toke.gbnf, then run `python3 scripts/gbnf_tune.py --write`.
# `make check-grammar-artefacts` fails if this file differs from a fresh
# generation, and (XGrammar installed) if XGrammar's verdict differs from the
# reference recogniser's on any fragment of test/gbnf/fragments.json.
#
# The same language as toke.gbnf, written for XGrammar's automata: every
# ws / ws1 reference is inlined as a whitespace character-class loop (comments
# stay a rule), and the rules that end a word token carry the lookahead
# assertion (= [^a-zA-Z0-9]), which XGrammar uses only to classify tokens
# when it builds its mask cache.  For other engines, use toke.gbnf.

root        ::= [ \t\r\n]* (comment [ \t\r\n]*)* moddecl (sep importdecl)* (sep typedecl)* (sep constdecl)* (sep letstmt)* (sep funcdecl)* ([ \t\r\n]* (comment [ \t\r\n]*)* ";")? [ \t\r\n]* (comment [ \t\r\n]*)*
sep         ::= [ \t\r\n]* (comment [ \t\r\n]*)* ";" [ \t\r\n]* (comment [ \t\r\n]*)*
moddecl     ::= "m" [ \t\r\n]* (comment [ \t\r\n]*)* "=" [ \t\r\n]* (comment [ \t\r\n]*)* modpath
importdecl  ::= "i" [ \t\r\n]* (comment [ \t\r\n]*)* "=" [ \t\r\n]* (comment [ \t\r\n]*)* ident [ \t\r\n]* (comment [ \t\r\n]*)* ":" [ \t\r\n]* (comment [ \t\r\n]*)* modpath ([ \t\r\n]* (comment [ \t\r\n]*)* string)?
modpath     ::= seg ([ \t\r\n]* (comment [ \t\r\n]*)* "." [ \t\r\n]* (comment [ \t\r\n]*)* seg)*
seg         ::= ident | typeident
typedecl    ::= "t" [ \t\r\n]* (comment [ \t\r\n]*)* "=" [ \t\r\n]* (comment [ \t\r\n]*)* ("$" [ \t\r\n]* (comment [ \t\r\n]*)* ident | ident | typeident) [ \t\r\n]* (comment [ \t\r\n]*)* "{" [ \t\r\n]* (comment [ \t\r\n]*)* field ([ \t\r\n]* (comment [ \t\r\n]*)* ";" [ \t\r\n]* (comment [ \t\r\n]*)* field)* [ \t\r\n]* (comment [ \t\r\n]*)* "}"
field       ::= ("$" [ \t\r\n]* (comment [ \t\r\n]*)*)? (ident | typeident) [ \t\r\n]* (comment [ \t\r\n]*)* ":" [ \t\r\n]* (comment [ \t\r\n]*)* type
constdecl   ::= cname [ \t\r\n]* (comment [ \t\r\n]*)* "=" [ \t\r\n]* (comment [ \t\r\n]*)* literal [ \t\r\n]* (comment [ \t\r\n]*)* ":" [ \t\r\n]* (comment [ \t\r\n]*)* type
funcdecl    ::= "f" [ \t\r\n]* (comment [ \t\r\n]*)* "=" [ \t\r\n]* (comment [ \t\r\n]*)* ident [ \t\r\n]* (comment [ \t\r\n]*)* "(" [ \t\r\n]* (comment [ \t\r\n]*)* params? [ \t\r\n]* (comment [ \t\r\n]*)* ")" [ \t\r\n]* (comment [ \t\r\n]*)* ":" [ \t\r\n]* (comment [ \t\r\n]*)* retspec ([ \t\r\n]* (comment [ \t\r\n]*)* block)?
params      ::= param ([ \t\r\n]* (comment [ \t\r\n]*)* ";" [ \t\r\n]* (comment [ \t\r\n]*)* param)*
param       ::= ident [ \t\r\n]* (comment [ \t\r\n]*)* ":" [ \t\r\n]* (comment [ \t\r\n]*)* type
retspec     ::= type ([ \t\r\n]* (comment [ \t\r\n]*)* "!" [ \t\r\n]* (comment [ \t\r\n]*)* type)?
block       ::= "{" [ \t\r\n]* (comment [ \t\r\n]*)* stmts? "}"
stmts       ::= (item [ \t\r\n]* (comment [ \t\r\n]*)*)* simple [ \t\r\n]* (comment [ \t\r\n]*)* | (item [ \t\r\n]* (comment [ \t\r\n]*)*)+
stmts-p     ::= simple-p [ \t\r\n]* (comment [ \t\r\n]*)* | item-p [ \t\r\n]* (comment [ \t\r\n]*)* stmts?
item        ::= simple [ \t\r\n]* (comment [ \t\r\n]*)* ";" | compound ([ \t\r\n]* (comment [ \t\r\n]*)* ";")? | arena ([ \t\r\n]* (comment [ \t\r\n]*)* ";")?
item-p      ::= simple-p [ \t\r\n]* (comment [ \t\r\n]*)* ";"
simple      ::= letstmt | assign | ret | "br" | scope | exprstmt
simple-p    ::= "<" ([ \t\r\n]* (comment [ \t\r\n]*)* expr)? | orx-p
compound    ::= ifstmt | loop
letstmt     ::= "let" ([ \t\r\n]+ (comment [ \t\r\n]*)* | comment [ \t\r\n]* (comment [ \t\r\n]*)*) ident ([ \t\r\n]* (comment [ \t\r\n]*)* ":" [ \t\r\n]* (comment [ \t\r\n]*)* type)? [ \t\r\n]* (comment [ \t\r\n]*)* "=" [ \t\r\n]* (comment [ \t\r\n]*)* ("mut" [ \t\r\n]* (comment [ \t\r\n]*)* "." [ \t\r\n]* (comment [ \t\r\n]*)*)? expr
