//
// GENERATED from docs/spec/toke.gbnf by scripts/gbnf_tune.py -- do not edit.
// Edit toke.gbnf, then run `python3 scripts/gbnf_tune.py --write`.
// `make check-grammar-artefacts` fails if this file differs from a fresh
