# toke v0.4 — GBNF grammar for grammar-constrained decoding (116.5 / A5)
#
# llama.cpp / Outlines / XGrammar consume this to guarantee that a model's
# generated bytes form a syntactically valid toke source file. It mirrors the
# normative token grammar in docs/spec/grammar.ebnf, lifted to the character
# level (whitespace is insignificant between tokens; `ws` may appear anywhere a
# token boundary is allowed). The reference parser is backtrack-free with
# bounded lookahead (see grammar.ebnf Appendix A), so this grammar is a faithful
# over-approximation suitable for constrained generation.
#
# NOTE: reflects the v0.4 changes — `==` equality / `=` assignment (A3),
# expression-`if` requiring `el` (A1), `&&`/`||` (A2).

root        ::= ws module (ws import)* (ws typedecl)* (ws constdecl)* (ws funcdecl)* ws

# ── declarations ───────────────────────────────────────────────────────────
module      ::= "m=" ws modulepath ws ";"
import      ::= "i=" ws ident ws ":" ws modulepath ws ";"
typedecl    ::= "t=" ws "$" typename ws "{" ws fieldlist ws "}" ws ";"
constdecl   ::= ident ws "=" ws literal ws ":" ws typeexpr ws ";"
funcdecl    ::= "f=" ws ident ws "(" ws paramlist? ws ")" ws ":" ws returnspec ws
                "{" ws stmtlist ws "}" ws ";"
modulepath  ::= ident ("." ident)*
typename    ::= ident
fieldlist   ::= field (ws ";" ws field)*
field       ::= ident ws ":" ws typeexpr
paramlist   ::= param (ws ";" ws param)*
param       ::= ident ws ":" ws typeexpr
returnspec  ::= typeexpr (ws "!" ws typeexpr)?

# ── statements ─────────────────────────────────────────────────────────────
stmtlist    ::= (ws stmt)* ws
stmt        ::= bindstmt | mutbindstmt | returnstmt | breakstmt
              | ifstmt | loopstmt | assignstmt | exprstmt
bindstmt    ::= "let" ws ident ws "=" ws expr ws ";"?
mutbindstmt ::= "let" ws ident ws "=" ws "mut." ws expr ws ";"?
assignstmt  ::= ident ws "=" ws expr ws ";"?
returnstmt  ::= ("<" | "rt") ws expr ws ";"?
breakstmt   ::= "br" ws ";"?
ifstmt      ::= "if" ws "(" ws expr ws ")" ws block (ws "el" ws block)? ws ";"?
loopstmt    ::= "lp" ws "(" ws loophead ws ")" ws block ws ";"?
loophead    ::= ("let" ws)? ident ws "=" ws expr ws ";" ws expr ws ";" ws
                ident ws "=" ws expr            # 3-clause init;cond;step
              | expr                            # while-form guard
block       ::= "{" ws stmtlist ws "}"
exprstmt    ::= expr ws ";"?

# ── expressions (precedence low→high; if/mt are keyword-led) ────────────────
expr        ::= ifexpr | matchexpr | logor
ifexpr      ::= "if" ws "(" ws expr ws ")" ws block ws "el" ws (ifexpr | block)
matchexpr   ::= "mt" ws logor ws "{" ws matcharm (ws ";" ws matcharm)* ws "}"
matcharm    ::= typeexpr ws ":" ws ident ws expr
logor       ::= logand (ws "||" ws logand)*
logand      ::= eq (ws "&&" ws eq)*
eq          ::= cmp (ws ("==" | "!=") ws cmp)?
cmp         ::= add (ws ("<=" | ">=" | "<" | ">") ws add)?
add         ::= mul (ws ("+" | "-") ws mul)*
mul         ::= unary (ws ("*" | "/" | "%") ws unary)*
unary       ::= ("-" | "!") ws unary | propagate
propagate   ::= call (ws "!" ws typeexpr)?
call        ::= postfix (ws "(" ws arglist? ws ")")*
postfix     ::= primary (ws "." ws ident (ws "(" ws arglist? ws ")")?)*
primary     ::= structlit | arraymap | funcref | "(" ws expr ws ")"
              | literal | ident
arglist     ::= expr (ws ";" ws expr)*

structlit   ::= "$" ident ws "{" ws fieldinit (ws ";" ws fieldinit)* ws "}"
fieldinit   ::= ident ws ":" ws expr
# @( ... ) is an array literal, or a map literal when elements are k:v pairs
arraymap    ::= "@(" ws ( maventries | arrentries )? ws ")"
arrentries  ::= expr (ws ";" ws expr)*
maventries  ::= expr ws ":" ws expr (ws ";" ws expr ws ":" ws expr)*
funcref     ::= "&" ident

# ── types ──────────────────────────────────────────────────────────────────
typeexpr    ::= scalar | "$" ident | "@" typeexpr
              | "@(" ws typeexpr ws ":" ws typeexpr ws ")"
scalar      ::= "u8" | "u16" | "u32" | "u64" | "i8" | "i16" | "i32" | "i64"
              | "f32" | "f64" | "bool" | "str" | "byte"

# ── lexical (character level) ───────────────────────────────────────────────
ident       ::= [a-z] [a-zA-Z0-9]*
literal     ::= float | int | string | bool
int         ::= "-"? [0-9]+
float       ::= "-"? [0-9]+ "." [0-9]+
string      ::= "\"" ( [^"\\] | "\\" . )* "\""
bool        ::= "true" | "false"
ws          ::= [ \t\r\n]*
