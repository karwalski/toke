# toke v0.4 — GBNF grammar for grammar-constrained decoding (116.5 / A5; rebuilt 131.52)
#
# llama.cpp / XGrammar / Outlines consume this to make a model's output a
# syntactically valid toke source file in the default syntax (not --legacy).
# It is written at the CHARACTER level, so it encodes the lexer as well as the
# parser (src/lexer.c + src/parser.c), and it is checked against the real
# front end by a drift gate:
#
#     make check-gbnf      (scripts/gbnf_gate.py over test/gbnf/fragments.json)
#
# which asserts   this grammar accepts F  <=>  `tkc --dump-ast F` parses F
# cleanly (exit 0 and no recovery warning: `#`/`//` comments, `let mut x`,
# `if(c):{`, `mut x` without the dot are repairs, not toke).  Edit this file
# and the gate together; the gate's KNOWN table lists the few places where a
# context-free grammar over-approximates the parser on purpose.  docs/spec/toke.lark
# is generated from this file (`python3 scripts/gbnf_to_lark.py --write`), and
# `make check-grammar-artefacts` fails if it is stale.
#
# How the lexer is encoded:
#   * `ws` (possibly empty) may separate any two tokens; it includes nested
#     `(* ... *)` comments.  `ws1` is a required separator.
#   * Two word tokens (identifiers, keywords, numbers) need a separator or
#     they lex as one: `let` ws1 name, `rt`/`mt`/`spawn`/arm bodies use
#     `expr-aw` ("expression after a word"), `x as T` needs ws1 when the left
#     side ends in a word character.  Rules suffixed `-p` start with a
#     punctuation character, `-ew`/`-ep` END with a word / punctuation one.
#   * Keywords (if el lp br let mut as rt sc mt, and true/false) are not
#     identifiers: `word` is a trie over the keyword set.
#   * `(*` always opens a comment, so a type after `(` that starts with `*`
#     needs a separator (`ptype`).
#   * `a.0.1` lexes `0.1` as a float, so consecutive constant indexes need a
#     separator (`idx2`).
# Parser rules encoded that a token grammar would miss:
#   * declaration order m= i= t= consts let-globals f=, one `;` between
#     declarations (optional after the last);
#   * `;` ends every simple statement except the last in a block; `if`/`lp`
#     take one optional `;`; `{arena ...}` takes none;
#   * comparisons do not chain (`a<b<c` is rejected);
#   * `if` and `mt` are whole expressions, never operands;
#   * a `mt` scrutinee may not end in a bare type reference (`$t{` would open
#     a struct literal), and `!` may not negate a struct literal.

root        ::= ws moddecl (sep importdecl)* (sep typedecl)* (sep constdecl)*
                (sep letstmt)* (sep funcdecl)* (ws ";")? ws
sep         ::= ws ";" ws

# ── declarations ───────────────────────────────────────────────────────────
moddecl     ::= "m" ws "=" ws modpath
importdecl  ::= "i" ws "=" ws ident ws ":" ws modpath (ws string)?
modpath     ::= seg (ws "." ws seg)*
seg         ::= ident | typeident
typedecl    ::= "t" ws "=" ws ("$" ws ident | ident | typeident) ws "{" ws field (ws ";" ws field)* ws "}"
field       ::= ("$" ws)? (ident | typeident) ws ":" ws type
constdecl   ::= cname ws "=" ws literal ws ":" ws type
funcdecl    ::= "f" ws "=" ws ident ws "(" ws params? ws ")" ws ":" ws retspec (ws block)?
params      ::= param (ws ";" ws param)*
param       ::= ident ws ":" ws type
retspec     ::= type (ws "!" ws type)?

# ── statements ─────────────────────────────────────────────────────────────
block       ::= "{" ws stmts? "}"
stmts       ::= (item ws)* simple ws | (item ws)+
stmts-p     ::= simple-p ws | item-p ws stmts?
item        ::= simple ws ";" | compound (ws ";")? | arena
item-p      ::= simple-p ws ";"
simple      ::= letstmt | assign | ret | "br" | scope | exprstmt
simple-p    ::= "<" (ws expr)? | orx-p
compound    ::= ifstmt | loop
letstmt     ::= "let" ws1 ident (ws ":" ws type)? ws "=" ws ("mut" ws "." ws)? expr
assign      ::= ident ws "=" ws expr
ret         ::= "<" (ws expr)? | "rt" expr-aw?
scope       ::= "sc" ws block
exprstmt    ::= mtexpr | orx
ifstmt      ::= "if" ws "(" ws expr ws ")" ws block (ws "el" (ws1 ifstmt | ws block))?
loop        ::= "lp" ws "(" ws (loop3 | expr) ws ")" ws block
loop3       ::= ("let" ws1)? ident ws "=" ws expr ws ";" ws expr ws ";" ws ident ws "=" ws expr
arena       ::= "{" ws "arena" (ws | ws1 stmts | stmts-p) "}"

# ── expressions ────────────────────────────────────────────────────────────
expr        ::= ifexpr | mtexpr | orx
expr-aw     ::= ws1 expr | orx-p
ifexpr      ::= "if" ws "(" ws expr ws ")" ws block ws "el" (ws1 ifexpr | ws block)
mtexpr      ::= "mt" (ws1 orx-nt | orx-nt-p) ws "{" ws arm (ws ";" ws arm)* (ws ";")? ws "}"
arm         ::= ("$" ws ident | ident | typeident) ws ":" ws ident (ws "<" (ws expr)? | expr-aw)

# the binary chain, flattened: precedence does not change the language,
# only the non-chaining comparison does
orx         ::= un orrest
orx-p       ::= un-p orrest
orrest      ::= arrest (ws cmpop ws arx)? (ws logop ws cmpx)*
arrest      ::= (ws arop ws un)*
arx         ::= un arrest
cmpx        ::= arx (ws cmpop ws arx)?
logop       ::= "||" | "&&" | "|" | "^" | "&"
cmpop       ::= "==" | "!=" | "<=" | ">=" | "<" | ">"
arop        ::= "<<" | ">>" | "+" | "-" | "*" | "/" | "%"
# scrutinee forms: the LAST operand is not a bare type reference
orx-nt      ::= un-nt | un orrest-nt
orx-nt-p    ::= un-nt-p | un-p orrest-nt
orrest-nt   ::= arrest ws arop ws un-nt
              | arrest ws cmpop ws arx-nt
              | arrest (ws cmpop ws arx)? (ws logop ws cmpx)* ws logop ws cmpx-nt
arx-nt      ::= (un ws arop ws)* un-nt
cmpx-nt     ::= arx-nt | arx ws cmpop ws arx-nt

un          ::= ("-" | "~") ws un | "!" ws un-nsl | cp | "spawn" expr-aw
un-p        ::= ("-" | "~") ws un | "!" ws un-nsl | cp-p
un-nsl      ::= ("-" | "~") ws un | "!" ws un-nsl | cp-nsl | "spawn" expr-aw
un-nt       ::= ("-" | "~") ws un-nt | "!" ws un-nt | cp-nt | "spawn" expr-aw
un-nt-p     ::= ("-" | "~") ws un-nt | "!" ws un-nt | cp-nt-p

# cast / propagate: `x as T`, `x!T`, `x as T!E`
cast-w      ::= (ws1 "as" asty)? prop?
cast-p      ::= (ws "as" asty)? prop?
cast1-w     ::= ws1 "as" asty prop? | prop
cast1-p     ::= ws "as" asty prop? | prop
asty        ::= ws1 type | type-p
prop        ::= ws "!" ws type

cp          ::= prim-ew cast-w | prim-ep cast-p | prim tl-ew cast-w | prim tl-ep cast-p | "fn" cast-w
cp-p        ::= prim-p-ew cast-w | prim-p-ep cast-p | prim-p tl-ew cast-w | prim-p tl-ep cast-p
cp-nsl      ::= prim-ew cast-w | prim-ep-nsl cast-p | prim-sl cast1-p
              | prim tl-ew cast-w | prim tl-ep cast-p | "fn" cast-w
cp-nt       ::= prim-ew-nt cast-w | prim-tr cast1-w | prim-ep cast-p
              | prim tl-ew cast-w | prim tl-ep cast-p | "fn" cast-w
cp-nt-p     ::= prim-ref cast-w | prim-typ cast1-w | prim-p-ep cast-p
              | prim-p tl-ew cast-w | prim-p tl-ep cast-p

# postfix tail: calls (args), fields .name, constant indexes .0
tl-ew       ::= tlg* (tlg-d | idx idx2*)
tl-ep       ::= tlg* tlg-c
tlg         ::= tlg-c | tlg-d
tlg-c       ::= (idx idx2*)? ws "(" ws args? ws ")"
tlg-d       ::= (idx idx2*)? ws "." ws vname
idx         ::= ws "." ws int
idx2        ::= ws1 "." ws int | "." ws1 int
args        ::= expr (ws ";" ws expr)*

# primaries, by first / last character class
prim        ::= prim-ew | prim-ep
prim-ew     ::= prim-ew-nt | prim-tr
prim-ew-nt  ::= vname | literal-w | prim-ref
prim-ep     ::= prim-ep-nsl | prim-sl
prim-ep-nsl ::= closure | string | prim-arr | prim-par
prim-p      ::= prim-p-ew | prim-p-ep
prim-p-ew   ::= prim-typ | prim-ref
prim-p-ep   ::= string | prim-slp | prim-arr | prim-par
prim-tr     ::= typeident | prim-typ
prim-typ    ::= "$" ws ident
prim-ref    ::= "&" ws ident
prim-sl     ::= typeident ws "{" sbody "}" | prim-slp
prim-slp    ::= "$" ws ident ws "{" sbody-d "}"
prim-arr    ::= "@" ws "(" ws (aitems ws)? ")"
prim-par    ::= "(" ws expr ws ")"
closure     ::= "fn" ws "(" ws params? ws ")" (ws ":" ws retspec)? ws block
sbody       ::= ws (finit (ws ";" ws finit)* (ws ";")? ws)?
sbody-d     ::= ws (finit-d (ws ";" ws finit-d)* (ws ";")? ws)?
finit       ::= (ident | typeident) ws ":" ws expr
finit-d     ::= ("$" ws)? (ident | typeident) ws ":" ws expr
aitems      ::= expr (ws ";" ws expr)* (ws ";")?
              | expr ws ":" ws expr (ws ";" ws expr ws ":" ws expr)* (ws ";")?

# ── types ──────────────────────────────────────────────────────────────────
type        ::= type-w | type-p
type-w      ::= scalar | typeident | ident ws "." ws "$" ws ident
type-p      ::= type-np-p | functype
type-np-p   ::= "$" ws ident | "*" ws type | "@" ws "(" ptype ws (":" ws type ws)? ")" | "@" ws (type-w | type-np-p)
functype    ::= "(" (ptype (ws ";" ws type)*)? ws ")" ws ":" ws type
ptype       ::= ws (type-w | "$" ws ident | "@" ws "(" ptype ws (":" ws type ws)? ")" | "@" ws (type-w | type-np-p) | functype)
              | ws1 "*" ws type
scalar      ::= "u8" | "u16" | "u32" | "u64" | "i8" | "i16" | "i32" | "i64"
              | "f32" | "f64" | "bool" | "str" | "byte" | "void"

# ── lexical ────────────────────────────────────────────────────────────────
literal     ::= literal-w | string
literal-w   ::= float | int | "true" | "false"
int         ::= "0" [xX] [0-9a-fA-F]+ | "0" [bB] [01]+ | [0-9]+
float       ::= [0-9]+ "." [0-9]+
string      ::= "\"" ([^"\\] | "\\" ["\\ntr0] | "\\x" [0-9a-fA-F] [0-9a-fA-F] | "\\(" interp ")")* "\""
interp      ::= ([^()] | "(" interp ")")*
typeident   ::= [A-Z] [a-zA-Z0-9]*
ident       ::= [a-z] | word | "fn"
vname       ::= [a-z] | word
cname       ::= [a-eg-hj-ln-su-z] | word | "fn"
# word: two or more characters, not a keyword and not `fn` (a trie)
word        ::= [cdghjkn-qu-z] [a-zA-Z0-9]+ | "a" word-a | "b" word-b | "e" word-e
              | "f" word-f | "i" word-i | "l" word-l | "m" word-m | "r" word-r
              | "s" word-s | "t" word-t
word-a      ::= [0-9A-Za-rt-z] [a-zA-Z0-9]* | "s" [a-zA-Z0-9]+
word-b      ::= [0-9A-Za-qs-z] [a-zA-Z0-9]* | "r" [a-zA-Z0-9]+
word-e      ::= [0-9A-Za-km-z] [a-zA-Z0-9]* | "l" [a-zA-Z0-9]+
word-f      ::= [0-9A-Zb-mo-z] [a-zA-Z0-9]* | "n" [a-zA-Z0-9]+ | "a" word-fa
word-fa     ::= "" | [0-9A-Za-km-z] [a-zA-Z0-9]* | "l" word-fal
word-fal    ::= "" | [0-9A-Za-rt-z] [a-zA-Z0-9]* | "s" word-fals
word-fals   ::= "" | [0-9A-Za-df-z] [a-zA-Z0-9]* | "e" [a-zA-Z0-9]+
word-i      ::= [0-9A-Za-eg-z] [a-zA-Z0-9]* | "f" [a-zA-Z0-9]+
word-l      ::= [0-9A-Za-df-oq-z] [a-zA-Z0-9]* | "p" [a-zA-Z0-9]+ | "e" word-le
word-le     ::= "" | [0-9A-Za-su-z] [a-zA-Z0-9]* | "t" [a-zA-Z0-9]+
word-m      ::= [0-9A-Za-sv-z] [a-zA-Z0-9]* | "t" [a-zA-Z0-9]+ | "u" word-mu
word-mu     ::= "" | [0-9A-Za-su-z] [a-zA-Z0-9]* | "t" [a-zA-Z0-9]+
word-r      ::= [0-9A-Za-su-z] [a-zA-Z0-9]* | "t" [a-zA-Z0-9]+
word-s      ::= [0-9A-Zabd-z] [a-zA-Z0-9]* | "c" [a-zA-Z0-9]+
word-t      ::= [0-9A-Za-qs-z] [a-zA-Z0-9]* | "r" word-tr
word-tr     ::= "" | [0-9A-Za-tv-z] [a-zA-Z0-9]* | "u" word-tru
word-tru    ::= "" | [0-9A-Za-df-z] [a-zA-Z0-9]* | "e" [a-zA-Z0-9]+

# whitespace and nested comments.  A comment body never contains `(*` or
# `*)`; before the closing `*)` it may not end in `(` (that would read `(*`).
ws          ::= ([ \t\r\n] | comment)*
ws1         ::= ([ \t\r\n] | comment)+
comment     ::= "(*" (cbody-n comment)* cbody "*)"
cbody       ::= cchunk* "*"*
cbody-n     ::= cchunk* ("*"+ | "*"* "("+)?
cchunk      ::= [^(*] | "("+ [^(*] | "*"+ ([^()*] | "("+ [^(*])
