{
  "schema_version": "1.0",
  "module": "std.encrypt",
  "imports": ["std.crypto"],
  "exports": [
    {
      "kind": "type",
      "name": "DecryptResult",
      "fields": [
        {"name": "ok",  "type": "[byte]"},
        {"name": "err", "type": "str"}
      ]
    },
    {
      "kind": "type",
      "name": "Keypair",
      "fields": [
        {"name": "pubkey",  "type": "[byte]"},
        {"name": "privkey", "type": "[byte]"}
      ]
    },
    {"kind": "func", "name": "encrypt.aes256gcmencrypt",    "params": ["[byte]", "[byte]", "[byte]", "[byte]"], "return": "[byte]"},
    {"kind": "func", "name": "encrypt.aes256gcmdecrypt",    "params": ["[byte]", "[byte]", "[byte]", "[byte]"], "return": "DecryptResult"},
    {"kind": "func", "name": "encrypt.aes256gcmkeygen",     "params": [],                                       "return": "[byte]"},
    {"kind": "func", "name": "encrypt.aes256gcmnoncegen",   "params": [],                                       "return": "[byte]"},
    {"kind": "func", "name": "encrypt.x25519keypair",       "params": [],                                       "return": "Keypair"},
    {"kind": "func", "name": "encrypt.x25519dh",            "params": ["[byte]", "[byte]"],                     "return": "[byte]"},
    {"kind": "func", "name": "encrypt.ed25519keypair",      "params": [],                                       "return": "Keypair"},
    {"kind": "func", "name": "encrypt.ed25519sign",         "params": ["[byte]", "[byte]"],                     "return": "[byte]"},
    {"kind": "func", "name": "encrypt.ed25519verify",       "params": ["[byte]", "[byte]", "[byte]"],           "return": "bool"},
    {"kind": "func", "name": "encrypt.hkdfsha256",          "params": ["[byte]", "[byte]", "[byte]", "u64"],   "return": "[byte]"},
    {"kind": "func", "name": "encrypt.tlscertfingerprint", "params": ["str"],                                  "return": "[byte]"}
  ]
}
