{
  "schema_version": "1.0",
  "module": "std.auth",
  "imports": ["std.encoding", "std.crypto"],
  "exports": [
    {
      "kind": "type",
      "name": "JwtClaims",
      "fields": [
        {"name": "sub", "type": "str"},
        {"name": "iss", "type": "str"},
        {"name": "iat", "type": "u64"},
        {"name": "exp", "type": "u64"},
        {"name": "aud", "type": "str"}
      ]
    },
    {
      "kind": "type",
      "name": "AuthErr",
      "fields": [
        {"name": "msg",  "type": "str"},
        {"name": "code", "type": "u64"}
      ]
    },
    {"kind": "func", "name": "auth.jwtsign",        "params": ["JwtClaims", "[byte]"], "return": "str!AuthErr"},
    {"kind": "func", "name": "auth.jwtverify",      "params": ["str", "[byte]"],       "return": "JwtClaims!AuthErr"},
    {"kind": "func", "name": "auth.jwtexpired",     "params": ["str"],                 "return": "bool"},
    {"kind": "func", "name": "auth.apikeygenerate", "params": [],                      "return": "str"},
    {"kind": "func", "name": "auth.apikeyvalidate", "params": ["str", "str"],          "return": "bool"},
    {"kind": "func", "name": "auth.bearerextract",  "params": ["str"],                 "return": "str!AuthErr"},
    {"kind": "func", "name": "auth.passwordhash",   "params": ["str"],                 "return": "str!AuthErr"},
    {"kind": "func", "name": "auth.passwordverify", "params": ["str", "str"],          "return": "bool"}
  ]
}
