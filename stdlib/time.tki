{
  "schema_version": "1.0",
  "module": "std.time",
  "exports": [
    {"kind": "func", "name": "time.now",    "params": [],             "return": "u64"},
    {"kind": "func", "name": "time.format", "params": ["u64", "str"], "return": "str"},
    {"kind": "func", "name": "time.since",  "params": ["u64"],        "return": "u64"},
    {"kind": "func", "name": "time.parse",  "params": ["str", "str"], "return": "u64!TimeErr"},
    {"kind": "func", "name": "time.add",    "params": ["u64", "i64"], "return": "u64"},
    {"kind": "func", "name": "time.diff",   "params": ["u64", "u64"], "return": "i64"},
    {
      "kind": "type",
      "name": "TimeParts",
      "fields": [
        {"name": "year",  "type": "i64"},
        {"name": "month", "type": "i64"},
        {"name": "day",   "type": "i64"},
        {"name": "hour",  "type": "i64"},
        {"name": "min",   "type": "i64"},
        {"name": "sec",   "type": "i64"}
      ]
    },
    {"kind": "func", "name": "time.toparts",   "params": ["u64"],         "return": "TimeParts"},
    {"kind": "func", "name": "time.fromparts", "params": ["TimeParts"],   "return": "u64"},
    {"kind": "func", "name": "time.weekday",    "params": ["u64"],         "return": "u64"},
    {"kind": "func", "name": "time.isleapyear", "params": ["i64"],       "return": "bool"},
    {"kind": "func", "name": "time.daysinmonth", "params": ["i64","i64"], "return": "u64"},
    {"kind": "func", "name": "time.withtz",    "params": ["u64", "str"],  "return": "str"},
    {"kind": "func", "name": "time.utcoffset", "params": ["str"],         "return": "i64"},
    {"kind": "func", "name": "time.convert",    "params": ["u64","str","str"], "return": "str"},
    {"kind": "func", "name": "time.adddays",   "params": ["u64", "i64"],  "return": "u64"},
    {"kind": "func", "name": "time.addmonths", "params": ["u64", "i64"],  "return": "u64"},
    {"kind": "func", "name": "time.addyears",  "params": ["u64", "i64"],  "return": "u64"},
    {"kind": "func", "name": "time.startofday",   "params": ["u64"],     "return": "u64"},
    {"kind": "func", "name": "time.startofmonth", "params": ["u64"],     "return": "u64"},
    {"kind": "func", "name": "time.startofyear",  "params": ["u64"],     "return": "u64"},
    {
      "kind": "type",
      "name": "Duration",
      "fields": [
        {"name": "years",   "type": "i64"},
        {"name": "months",  "type": "i64"},
        {"name": "days",    "type": "i64"},
        {"name": "hours",   "type": "i64"},
        {"name": "minutes", "type": "i64"},
        {"name": "seconds", "type": "i64"}
      ]
    },
    {"kind": "func", "name": "time.parseduration",  "params": ["str"],         "return": "Duration!TimeErr"},
    {"kind": "func", "name": "time.formatduration", "params": ["Duration"],    "return": "str"},
    {"kind": "func", "name": "time.duration",        "params": ["u64", "u64"],  "return": "Duration"},
    {"kind": "func", "name": "time.juliandate",  "params": ["u64"],           "return": "f64"},
    {"kind": "func", "name": "time.marssol",     "params": ["u64"],           "return": "f64"},
    {"kind": "func", "name": "time.formatmars",  "params": ["f64", "str"],    "return": "str"},
    {"kind": "func", "name": "time.lightdelay",  "params": ["str","str","u64"], "return": "f64"},
    {
      "kind": "sum_type",
      "name": "TimeErr",
      "variants": [
        {"name": "ParseErr",  "type": "str"},
        {"name": "RangeErr",  "type": "str"}
      ]
    }
  ]
}
