{
  "schema_version": "1.0",
  "module": "std.keychain",
  "exports": [
    {"kind": "func", "name": "keychain.set",          "params": ["str", "str", "str"], "return": "bool"},
    {"kind": "func", "name": "keychain.get",          "params": ["str", "str"],        "return": "?(str)"},
    {"kind": "func", "name": "keychain.delete",       "params": ["str", "str"],        "return": "bool"},
    {"kind": "func", "name": "keychain.exists",       "params": ["str", "str"],        "return": "bool"},
    {"kind": "func", "name": "keychain.isavailable", "params": [],                    "return": "bool"},
    {"kind": "func", "name": "keychain.laststatus",  "params": [],                    "return": "i64"},
    {"kind": "func", "name": "keychain.lasterrkind", "params": [],                    "return": "str"},
    {"kind": "func", "name": "keychain.lasterr",     "params": [],                    "return": "str"},
    {"kind": "func", "name": "keychain.create",      "params": ["str", "str"],        "return": "bool"},
    {"kind": "func", "name": "keychain.use",         "params": ["str"],               "return": "bool"},
    {"kind": "func", "name": "keychain.destroy",     "params": ["str"],               "return": "bool"}
  ]
}
