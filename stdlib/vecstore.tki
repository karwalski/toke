{
  "schema_version": "1.0",
  "module": "std.vecstore",
  "exports": [
    {
      "kind": "type",
      "name": "vecstorehandle",
      "fields": [
        {"name": "path", "type": "str"}
      ]
    },
    {
      "kind": "type",
      "name": "veccollection",
      "fields": [
        {"name": "name", "type": "str"}
      ]
    },
    {
      "kind": "type",
      "name": "vecentry",
      "fields": [
        {"name": "id",         "type": "str"},
        {"name": "embedding",  "type": "[f64]"},
        {"name": "payload",    "type": "str"},
        {"name": "createdat",  "type": "i64"}
      ]
    },
    {
      "kind": "type",
      "name": "searchresult",
      "fields": [
        {"name": "id",      "type": "str"},
        {"name": "score",   "type": "f64"},
        {"name": "payload", "type": "str"}
      ]
    },
    {
      "kind": "type",
      "name": "vecerr",
      "is_sum": true,
      "fields": [
        {"name": "$ioerr",       "type": "str"},
        {"name": "$dimmismatch", "type": "str"},
        {"name": "$notfound",    "type": "str"}
      ]
    },
    {"kind": "func", "name": "vecstore.open",         "params": ["str"],                                     "return": "vecstorehandle!vecerr"},
    {"kind": "func", "name": "vecstore.close",        "params": ["vecstorehandle"],                                "return": "void"},
    {"kind": "func", "name": "vecstore.flush",        "params": ["vecstorehandle"],                                "return": "bool"},
    {"kind": "func", "name": "vecstore.collection",   "params": ["vecstorehandle", "str"],                         "return": "veccollection!vecerr"},
    {"kind": "func", "name": "vecstore.upsert",       "params": ["veccollection", "str", "@(f64)", "str"],   "return": "bool"},
    {"kind": "func", "name": "vecstore.search",       "params": ["veccollection", "@(f64)", "i32", "f64"],   "return": "@(searchresult)"},
    {"kind": "func", "name": "vecstore.delete",       "params": ["veccollection", "str"],                    "return": "bool"},
    {"kind": "func", "name": "vecstore.deletebefore", "params": ["veccollection", "i64"],                    "return": "i32"},
    {"kind": "func", "name": "vecstore.count",        "params": ["veccollection"],                           "return": "i32"}
  ]
}
