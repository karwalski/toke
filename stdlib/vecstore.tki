{
  "schema_version": "1.0",
  "module": "std.vecstore",
  "exports": [
    {
      "kind": "type",
      "name": "VecStore",
      "fields": [
        {"name": "path", "type": "str"}
      ]
    },
    {
      "kind": "type",
      "name": "VecCollection",
      "fields": [
        {"name": "name", "type": "str"}
      ]
    },
    {
      "kind": "type",
      "name": "VecEntry",
      "fields": [
        {"name": "id",         "type": "str"},
        {"name": "embedding",  "type": "@(f64)"},
        {"name": "payload",    "type": "str"},
        {"name": "createdat",  "type": "i64"}
      ]
    },
    {
      "kind": "type",
      "name": "SearchResult",
      "fields": [
        {"name": "id",      "type": "str"},
        {"name": "score",   "type": "f64"},
        {"name": "payload", "type": "str"}
      ]
    },
    {
      "kind": "type",
      "name": "VecErr",
      "is_sum": true,
      "fields": [
        {"name": "$ioerr",       "type": "str"},
        {"name": "$dimmismatch", "type": "str"},
        {"name": "$notfound",    "type": "str"}
      ]
    },
    {"kind": "func", "name": "vecstore.open",         "params": ["str"],                                     "return": "VecStore!VecErr"},
    {"kind": "func", "name": "vecstore.close",        "params": ["VecStore"],                                "return": "void"},
    {"kind": "func", "name": "vecstore.collection",   "params": ["VecStore", "str"],                         "return": "VecCollection!VecErr"},
    {"kind": "func", "name": "vecstore.upsert",       "params": ["VecCollection", "str", "@(f64)", "str"],   "return": "bool"},
    {"kind": "func", "name": "vecstore.search",       "params": ["VecCollection", "@(f64)", "i32", "f64"],   "return": "@(SearchResult)"},
    {"kind": "func", "name": "vecstore.delete",       "params": ["VecCollection", "str"],                    "return": "bool"},
    {"kind": "func", "name": "vecstore.deletebefore", "params": ["VecCollection", "i64"],                    "return": "i32"},
    {"kind": "func", "name": "vecstore.count",        "params": ["VecCollection"],                           "return": "i32"}
  ]
}
