{
  "schema_version": "1.0",
  "module": "std.canvas",
  "exports": [
    {
      "kind": "type",
      "name": "canvasop",
      "opaque": true,
      "fields": [
        {"name": "tag", "type": "str"},
        {"name": "data", "type": "str"}
      ]
    },
    {
      "kind": "type",
      "name": "canvas",
      "fields": [
        {"name": "id",     "type": "str"},
        {"name": "width",  "type": "u32"},
        {"name": "height", "type": "u32"},
        {"name": "ops",    "type": "[canvasop]"}
      ]
    },
    {"kind": "func", "name": "canvas.new",         "params": ["str", "u32", "u32"],                       "return": "canvas"},
    {"kind": "func", "name": "canvas.fillrect",   "params": ["canvas", "f64", "f64", "f64", "f64", "str"], "return": "canvas"},
    {"kind": "func", "name": "canvas.strokerect", "params": ["canvas", "f64", "f64", "f64", "f64", "str", "f64"], "return": "canvas"},
    {"kind": "func", "name": "canvas.clearrect",  "params": ["canvas", "f64", "f64", "f64", "f64"],       "return": "canvas"},
    {"kind": "func", "name": "canvas.filltext",   "params": ["canvas", "str", "f64", "f64", "str", "str"], "return": "canvas"},
    {"kind": "func", "name": "canvas.beginpath",  "params": ["canvas"],                                   "return": "canvas"},
    {"kind": "func", "name": "canvas.moveto",     "params": ["canvas", "f64", "f64"],                     "return": "canvas"},
    {"kind": "func", "name": "canvas.lineto",     "params": ["canvas", "f64", "f64"],                     "return": "canvas"},
    {"kind": "func", "name": "canvas.arc",         "params": ["canvas", "f64", "f64", "f64", "f64", "f64"], "return": "canvas"},
    {"kind": "func", "name": "canvas.closepath",  "params": ["canvas"],                                   "return": "canvas"},
    {"kind": "func", "name": "canvas.fill",        "params": ["canvas", "str"],                            "return": "canvas"},
    {"kind": "func", "name": "canvas.stroke",      "params": ["canvas", "str", "f64"],                     "return": "canvas"},
    {"kind": "func", "name": "canvas.drawimage",  "params": ["canvas", "str", "f64", "f64", "f64", "f64"], "return": "canvas"},
    {"kind": "func", "name": "canvas.setalpha",   "params": ["canvas", "f64"],                            "return": "canvas"},
    {"kind": "func", "name": "canvas.tojs",       "params": ["canvas"],                                   "return": "str"},
    {"kind": "func", "name": "canvas.tohtml",     "params": ["canvas"],                                   "return": "str"}
  ]
}
