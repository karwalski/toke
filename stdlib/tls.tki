{
  "schema_version": "1.0",
  "module": "std.tls",
  "exports": [
    {
      "kind": "type",
      "name": "TlsConfig",
      "fields": [
        {"name": "certpem",       "type": "str"},
        {"name": "keypem",        "type": "str"},
        {"name": "peercertpem",  "type": "str"},
        {"name": "requiremutual", "type": "bool"}
      ]
    },
    {
      "kind": "type",
      "name": "TlsConn",
      "fields": [
        {"name": "id", "type": "str"}
      ]
    },
    {
      "kind": "type",
      "name": "TlsKeypair",
      "fields": [
        {"name": "certpem", "type": "str"},
        {"name": "keypem",  "type": "str"}
      ]
    },
    {
      "kind": "sum_type",
      "name": "TlsErr",
      "variants": [
        {"name": "CertErr",    "type": "str"},
        {"name": "ConnErr",    "type": "str"},
        {"name": "PinErr",     "type": "str"},
        {"name": "IoErr",      "type": "str"}
      ]
    },
    {"kind": "func", "name": "tls.genselfsigned", "params": ["str", "i32"],               "return": "TlsKeypair!TlsErr"},
    {"kind": "func", "name": "tls.genselfsignedalg", "params": ["str", "i32", "str"], "return": "TlsKeypair!TlsErr"},
    {"kind": "func", "name": "tls.certof",           "params": ["TlsKeypair"],               "return": "str"},
    {"kind": "func", "name": "tls.keyof",            "params": ["TlsKeypair"],               "return": "str"},
    {"kind": "func", "name": "tls.freekeypair",      "params": ["TlsKeypair"],               "return": "bool"},
    {"kind": "func", "name": "tls.tlsconfig",        "params": ["str", "str"],               "return": "TlsConfig"},
    {"kind": "func", "name": "tls.pinconfig",        "params": ["str", "str", "str"],        "return": "TlsConfig"},
    {"kind": "func", "name": "tls.mutualconfig",     "params": ["str", "str", "str"],        "return": "TlsConfig"},
    {"kind": "func", "name": "tls.freeconfig",       "params": ["TlsConfig"],                "return": "bool"},
    {"kind": "func", "name": "tls.protocol",         "params": ["TlsConn"],                  "return": "str"},
    {"kind": "func", "name": "tls.listen",           "params": ["i32", "TlsConfig", "fn"],   "return": "bool"},
    {"kind": "func", "name": "tls.connect",          "params": ["str", "i32", "TlsConfig"],  "return": "?(TlsConn)"},
    {"kind": "func", "name": "tls.read",             "params": ["TlsConn"],                  "return": "?(str)"},
    {"kind": "func", "name": "tls.write",            "params": ["TlsConn", "str"],            "return": "bool"},
    {"kind": "func", "name": "tls.close",            "params": ["TlsConn"],                  "return": "bool"},
    {"kind": "func", "name": "tls.peercert",        "params": ["TlsConn"],                  "return": "?(str)"},
    {"kind": "func", "name": "tls.fingerprint",      "params": ["str"],                       "return": "str"},
    {"kind": "func", "name": "tls.pairingcode",     "params": ["TlsConn"],                  "return": "str"}
  ]
}
