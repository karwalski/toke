{
  "schema_version": "1.0",
  "module": "std.toml",
  "exports": [
    {"kind": "type",   "name": "tomlval", "opaque": true},
    {"kind": "type",   "name": "tomlerr",  "fields": [{"name": "msg", "type": "str"}]},
    {"kind": "func",   "name": "toml.load",     "params": ["str"],              "return": "tomlval!tomlerr"},
    {"kind": "func",   "name": "toml.loadfile",  "params": ["str"],              "return": "tomlval!tomlerr"},
    {"kind": "func",   "name": "toml.str",       "params": ["tomlval", "str"],   "return": "str!tomlerr"},
    {"kind": "func",   "name": "toml.i64",       "params": ["tomlval", "str"],   "return": "i64!tomlerr"},
    {"kind": "func",   "name": "toml.bool",      "params": ["tomlval", "str"],   "return": "bool!tomlerr"},
    {"kind": "func",   "name": "toml.f64",       "params": ["tomlval", "str"],   "return": "f64!tomlerr"},
    {"kind": "func",   "name": "toml.has",       "params": ["tomlval", "str"],   "return": "bool"},
    {"kind": "func",   "name": "toml.section",   "params": ["tomlval", "str"],   "return": "tomlval!tomlerr"},
    {"kind": "func",   "name": "toml.strarr",    "params": ["tomlval", "str"],   "return": "[str]!tomlerr"},
    {"kind": "func",   "name": "toml.i64arr",    "params": ["tomlval", "str"],   "return": "[i64]!tomlerr"},
    {"kind": "func",   "name": "toml.boolarr",   "params": ["tomlval", "str"],   "return": "[bool]!tomlerr"},
    {"kind": "func",   "name": "toml.sectionarr", "params": ["tomlval", "str"],  "return": "[tomlval]!tomlerr"},
    {"kind": "func",   "name": "toml.keys",      "params": ["tomlval"],          "return": "[str]"},
    {"kind": "func",   "name": "toml.len",       "params": ["tomlval"],          "return": "u64"},
    {"kind": "func",   "name": "toml.free",      "params": ["tomlval"],          "return": "bool"}
  ]
}
