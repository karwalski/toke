{
  "schema_version": "1.0",
  "module": "std.infer",
  "exports": [
    {
      "kind": "type",
      "name": "modelhandle",
      "opaque": true,
      "fields": [
        {
          "name": "id",
          "type": "str"
        }
      ]
    },
    {
      "kind": "type",
      "name": "inferopts",
      "fields": [
        {
          "name": "ngpulayers",
          "type": "i32"
        },
        {
          "name": "nthreads",
          "type": "i32"
        },
        {
          "name": "seed",
          "type": "i32"
        }
      ]
    },
    {
      "kind": "type",
      "name": "streamopts",
      "fields": [
        {
          "name": "ramceilinggb",
          "type": "f32"
        },
        {
          "name": "prefetchlayers",
          "type": "i32"
        },
        {
          "name": "requiresnvme",
          "type": "bool"
        }
      ]
    },
    {
      "kind": "type",
      "name": "infererr",
      "fields": [
        {
          "name": "msg",
          "type": "str"
        },
        {
          "name": "code",
          "type": "i32"
        }
      ]
    },
    {
      "kind": "func",
      "name": "infer.load",
      "params": [
        "str",
        "inferopts"
      ],
      "return": "modelhandle!infererr"
    },
    {
      "kind": "func",
      "name": "infer.unload",
      "params": [
        "modelhandle"
      ],
      "return": "bool"
    },
    {
      "kind": "func",
      "name": "infer.generate",
      "params": [
        "modelhandle",
        "str",
        "i32"
      ],
      "return": "str!infererr"
    },
    {
      "kind": "func",
      "name": "infer.embed",
      "params": [
        "modelhandle",
        "str"
      ],
      "return": "@(f32)!infererr"
    },
    {
      "kind": "func",
      "name": "infer.isloaded",
      "params": [
        "modelhandle"
      ],
      "return": "bool"
    },
    {
      "kind": "func",
      "name": "infer.loadstreaming",
      "params": [
        "str",
        "streamopts"
      ],
      "return": "modelhandle!infererr"
    }
  ]
}
