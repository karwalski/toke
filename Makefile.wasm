# Makefile.wasm — Emscripten build for tkc WASM module.
#
# Compiles the toke reference compiler to WebAssembly for use in a
# browser-based playground.  Requires the Emscripten SDK (emcc on PATH).
#
# Usage:
#   source /path/to/emsdk/emsdk_env.sh
#   make -f Makefile.wasm
#
# Story: 10.12.31

CC      = emcc
CFLAGS  = -std=c99 -D_GNU_SOURCE -Wall -Wextra -Wpedantic -Werror \
          -Wno-misleading-indentation -DTKC_WASM_BUILD \
          -DTKC_STDLIB_DIR='"/stdlib"'

# Sources: all compiler pipeline files plus the WASM API shim.
# Excludes main.c (replaced by wasm_api.c) and ir.c (no codegen in the
# browser — check and format only).
#
# 136.64: the type checker (types.c) resolves stdlib calls through the
# stdlib lookup tables (stdlib_symbol_for, recv_method_*, stdlib_glue_arity,
# ...) and stdlib_deps.c (stdlib_module_registered), so those must link.
# Leaving them out made this build fail to link with 8 undefined symbols --
# which nobody saw, because nothing built it.
# 135.21: the tables moved out of llvm.c into stdlib_tables.c, so the browser
# build no longer carries the code generator (llvm.c) or the glue generator
# its link step pulled in (glue_gen.c).
#
# There is no emcc on the development hosts or in CI.  test/conform/
# C135_wasm_build_stand_in.sh compiles exactly this source list (read via
# `make -f Makefile.wasm print-srcs`) with the host compiler, -DTKC_WASM_BUILD
# and these warning flags, links it, and drives the exported API.  It proves
# the C is valid and the API works; it does not prove emcc accepts it.
SRCS    = src/lexer.c src/parser.c src/names.c src/types.c \
          src/arena.c src/diag.c src/config.c src/fmt.c \
          src/stdlib_tables.c src/stdlib_deps.c \
          src/stdlib/str.c \
          src/wasm_api.c

OUTDIR  = wasm
TARGET  = $(OUTDIR)/tkc.js

# Functions exported to JavaScript via cwrap / ccall.
EXPORTED_FUNCTIONS = _tkc_check_source,_tkc_format_source,_tkc_get_diagnostics,_tkc_version,_tkc_free,_malloc,_free

# Runtime helpers available in JS.
EXPORTED_RUNTIME = ccall,cwrap,UTF8ToString,stringToUTF8,lengthBytesUTF8

# Emscripten link flags.
EM_FLAGS = -O2 \
           -s TOTAL_MEMORY=16MB \
           -s EXPORTED_FUNCTIONS='[$(EXPORTED_FUNCTIONS)]' \
           -s EXPORTED_RUNTIME_METHODS='[$(EXPORTED_RUNTIME)]' \
           -s MODULARIZE=1 \
           -s EXPORT_NAME='createTkcModule' \
           -s NO_FILESYSTEM=1 \
           -s ALLOW_MEMORY_GROWTH=0 \
           -s ENVIRONMENT='web' \
           -s SINGLE_FILE=0

.PHONY: all clean print-srcs

# For the host stand-in (C135): the source list and the compile flags, minus
# the compiler itself, so the stand-in cannot drift from this file.
print-srcs:
	@echo 'SRCS=$(SRCS)'
	@echo 'CFLAGS=$(CFLAGS)'
	@echo 'EXPORTED_FUNCTIONS=$(EXPORTED_FUNCTIONS)'

all: $(TARGET)

$(TARGET): $(SRCS) | $(OUTDIR)
	$(CC) $(CFLAGS) $(EM_FLAGS) -o $@ $(SRCS)

$(OUTDIR):
	mkdir -p $(OUTDIR)

clean:
	rm -f $(OUTDIR)/tkc.js $(OUTDIR)/tkc.wasm
