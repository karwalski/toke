# Build outputs
tkc
*.o
*.a
*.ll
*.bc
*.tki
# Hand-crafted stdlib interface files are tracked (exception to *.tki)
!stdlib/*.tki

# LLVM build artifacts
build/
cmake-build-*/

# Editor
.vscode/
.idea/
*.swp

# macOS
.DS_Store
**/.DS_Store

# Xcode / Instruments
*.plist
.claude/

# Test outputs
test/output/
test/*.out

# Compiled test binaries in test/stdlib/ — ignore the extensionless build
# outputs, keep every source file. Written as a pattern, not a list: the
# hand-maintained list this replaces had drifted by six binaries, which is the
# same failure mode as 134.21 (a build input untracked because an ignore rule
# was written for output) and 127.85 (a vendored source tree ignored while its
# comment claimed otherwise). A list somebody must remember to update is the
# recurring root cause in this repo — see also 127.80, where an interface cache
# read 26 of 56 files from a hand-written list.
test/stdlib/*
!test/stdlib/*.c
!test/stdlib/*.h
!test/stdlib/*.tk
!test/stdlib/*.sh
!test/stdlib/*.py
!test/stdlib/*.md
!test/stdlib/*.d
!test/stdlib/*/
**/*.dSYM/

# Temporary / generated files
tmp*.ll
out.txt
output.txt
stress_chained_functions

# ── Vendored third-party sources (stdlib/vendor) ────────────────────────────
# These sources really ARE tracked, and must stay tracked: `tkc --out` compiles
# stdlib/vendor/tomlc99/toml.c and stdlib/vendor/cmark/src/*.c directly into
# every binary that imports std.toml or std.md, so a clone missing them cannot
# build those programs at all.  (Before story 127.85 the two directories were
# ignored outright while this comment claimed the opposite — a fresh clone had
# zero vendored files and failed with an opaque clang E9003.)
#
# Only the files the build consumes are tracked.  Upstream test suites, docs,
# build systems, benchmarks and any local clone metadata stay ignored, which is
# why this is a whitelist: each directory is excluded, then re-included
# file-by-file (git cannot re-include a path under an excluded directory).
#
# Provenance, pinned upstream commits and the update procedure:
#   stdlib/vendor/README.md
stdlib/vendor/*
!stdlib/vendor/README.md

# cmark (CommonMark reference implementation) — backs src/stdlib/md.c
!stdlib/vendor/cmark/
stdlib/vendor/cmark/*
!stdlib/vendor/cmark/COPYING
!stdlib/vendor/cmark/src/
stdlib/vendor/cmark/src/*
!stdlib/vendor/cmark/src/*.c
!stdlib/vendor/cmark/src/*.h
!stdlib/vendor/cmark/src/*.inc
# main.c defines its own main(); the build filters it out, so it is not tracked.
stdlib/vendor/cmark/src/main.c

# tomlc99 — backs src/stdlib/toml.c
!stdlib/vendor/tomlc99/
stdlib/vendor/tomlc99/*
!stdlib/vendor/tomlc99/LICENSE
!stdlib/vendor/tomlc99/toml.c
!stdlib/vendor/tomlc99/toml.h

# miniz (single-file DEFLATE + zip reader) — backs src/stdlib/zip.c (135.1)
!stdlib/vendor/miniz/
stdlib/vendor/miniz/*
!stdlib/vendor/miniz/LICENSE
!stdlib/vendor/miniz/miniz.c
!stdlib/vendor/miniz/miniz.h

# Logs
logs/

# header-dependency files from -MMD
*.d

# 127.107 — Python bytecode and benchmark run output. These appeared in
# `git status` on every run and are exactly the noise that let three separate
# commits sweep in another agent's work today (131.66).
__pycache__/
*.pyc
bench/patterns/results/
patterns/probe/*.before.json

# 127.107 — the compiler is build output. It was tracked, so it showed as
# modified after every build and could be swept into an unrelated commit.
# `make` produces it; the reproducible artefact is the pinned build (131.73).
/toke

# 136.42 — compiled test binaries in test/tkir/, same pattern shape as
# test/stdlib/ above. `test/tkir/test_tkir_reader` was tracked with no ignore
# rule at all, so nothing even flagged it; `git rm --cached` alone would have
# let the next build re-add it.
test/tkir/*
!test/tkir/*.c
!test/tkir/*.h
!test/tkir/*.tk
!test/tkir/*.sh
!test/tkir/*.py
!test/tkir/*.md
!test/tkir/*.d
!test/tkir/*/
