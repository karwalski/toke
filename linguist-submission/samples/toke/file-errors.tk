m=filereader;

i=io:std.io;
i=file:std.file;
i=str:std.str;
i=log:std.log;

f=linecount(text:$str):u64{
  let lines=str.split(text; "\n");
  <lines.len;
};

f=wordcount(text:$str):i64{
  let words=str.split(text; " ");
  let count=mut.0;
  lp(let i=0;i<words.len;i=i+1){
    let w=str.trim(words.get(i));
    if(!(w=="")){
      count=count+1;
    };
  };
  <count;
};

f=errtext(e:$fileerr):$str{
  <mt e {
    $notfound:p str.concat("not found: "; p);
    $permission:p str.concat("permission denied: "; p);
    $io:p str.concat("io error: "; p);
    $invalid:p str.concat("invalid path: "; p);
    $isdir:p str.concat("is a directory: "; p);
    $notregular:p str.concat("not a regular file: "; p);
    $symlink:p str.concat("symlink refused: "; p);
    $toolarge:p str.concat("too large: "; p);
    $nomem:p str.concat("out of memory: "; p);
    $badarg:p str.concat("bad argument: "; p)
  };
};

f=report(path:$str;content:$str):i64{
  log.info(str.concat("file: "; path);@());
  log.info("lines: \(linecount(content))";@());
  log.info(str.concat("words: "; str.fromint(wordcount(content)));@());
  <0;
};

f=processfile(path:$str):i64{
  <mt file.read(path) {
    $ok:content report(path; content);
    $err:e io.println(errtext(e))
  };
};

f=main():i64{
  let files=@("README.md";"src/main.tk";"missing.txt");
  lp(let i=0;i<files.len;i=i+1){
    processfile(files.get(i));
  };
  <0;
};
