    io.println("PASS math.min(@(3.0;7.0)) == 3")
  }el{
    io.println("FAIL math.min(@(3.0;7.0))");
    fails=fails+1
  };
  let mxeq=math.max(@(10.0;10.0));
  if(mxeq==10.0){
    io.println("PASS math.max(@(10.0;10.0)) == 10")
  }el{
    io.println("FAIL math.max(@(10.0;10.0))");
