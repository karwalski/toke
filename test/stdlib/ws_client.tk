(* ws_client.tk -- std.ws client surface, type-checked (127.149).

   Rewritten 2026-09-24 from a v0.2-era file that had never compiled at
   v0.4 (`=` for equality, `:void` on value-returning functions, a loop
   header mangled into a function signature by a migration). The helpers
   below exercise the std.ws client exports with the v0.4 error-handling
   shape; they need a live server, so main() does not call them. main()
   checks the parts that need none: the wsconn/wsmsg record shapes.

   ws.sendbytes is named by binaryroundtrip below, so this program only
   links while tk_ws_sendbytes_w exists (127.150). Its behaviour on the
   wire is tested by test/conform/C107_ws_sendbytes.sh.

   Built, linked and run by `make test-stdlib-ws-client-tk`. *)
m=wsclienttest;
i=ws:std.ws;
i=io:std.io;
i=str:std.str;

f=echoroundtrip(url:$str):bool{
  let conn=mt ws.connect(url){$ok:c c;$err:e <false};
  mt ws.send(conn;"hello"){$ok:v v;$err:e <false};
  let n=mt ws.recv(conn){$ok:m m.payload.len;$err:e 0};
  ws.close(conn);
  <n==5
};

f=binaryroundtrip(url:$str):bool{
  let conn=mt ws.connect(url){$ok:c c;$err:e <false};
  mt ws.sendbytes(conn;@(0;1;2;255)){$ok:v v;$err:e <false};
  let op=mt ws.recv(conn){$ok:m m.opcode;$err:e 0};
  ws.close(conn);
  <op==2
};

f=recvuntilclose(url:$str):i64{
  let conn=mt ws.connect(url){$ok:c c;$err:e <0-1};
  let count=mut.0;
  let running=mut.true;
  lp(let k=0;running;k=k+1){
    let op=mt ws.recv(conn){$ok:m m.opcode;$err:e 8};
    if(op==8){running=false}el{count=count+1};
  };
  ws.close(conn);
  <count
};

f=notifyall(conns:@($wsconn);status:$str):i64{
  ws.broadcast(conns;str.concat("{\"status\":\"";str.concat(status;"\"}")));
  <0
};

f=main():i64{
  let dummy=$wsconn{id:0;ready:false};
  let msg=$wsmsg{payload:@();fin:true;opcode:1};
  if(dummy.id==0){io.println("pass: wsconn.id")}el{<1};
  if(msg.fin){io.println("pass: wsmsg.fin")}el{<1};
  if(msg.opcode==1){io.println("pass: wsmsg.opcode")}el{<1};
  <0
};
