m=main;
i=io:std.io;
i=s:std.str;
i=env:std.env;
f=main():i64{
  let n=env.getint("PAT_N";1000);
  let b=s.builder();
  lp(let i=0;i<n;i=i+1){s.add(b;"tok\(i),")};
  let t=s.build(b);
  let cnt=mut.0;
  let p=mut.s.indexfrom(t;",";0);
  lp(let k=0;p>=0;k=k+1){
    cnt=cnt+1;
    p=s.indexfrom(t;",";p+1)
  };
  io.println("n=\(cnt)");
  <0
};
