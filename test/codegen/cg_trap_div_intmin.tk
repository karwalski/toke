(* 123.6 certificate for 121.36 (a witness until 127.217 fixed it): ADR-0012
 * (b) requires a guard on INT64_MIN / -1 as well as on a zero divisor.  There
 * was none: the quotient is machine UB, and the build was not even
 * self-consistent — measured 2026-09-25, -O0 printed -9223372036854775808 and
 * -O2 printed 0.  Only the RT004 code is pinned.  The FAIL line does not
 * print the quotient, because it differed by optimisation level.
 * expect-exit: 1
 * expect-stderr: RT004: *)
m=cgtrapdivintmin;
i=io:std.io;
f=mn():i64{<0-9223372036854775807-1};
f=m1(n:i64):i64{<n-n-1};
f=main():i64{
  io.println("min \(mn()) divisor \(m1(3))");
  let q=mn()/m1(3);
  if(q==q){io.println("FAIL INT64_MIN / -1 did not trap")};
  <0
};
