(* 123.6 certificate (a witness until 127.217 fixed it): interpolating a
 * `byte` value compiled clean and the binary was killed by SIGSEGV before
 * printing anything — codegen did not know the lower-case `byte` spelling,
 * so `65 as byte` became an inttoptr and the "string" was address 65; `\(b as i64)` on the same value prints 65.  The byte
 * type has no written rendering, so the only assertion is the one both
 * possible renderings share: the program must not crash, and the line
 * printed after it must appear. *)
m=cginterpbyte;
i=io:std.io;
f=main():i64{
  let by=65 as byte;
  io.println("as i64 \(by as i64)");
  let s="\(by)";
  if(s.len>0){io.println("interpolated a byte without crashing")}el{io.println("FAIL interpolating a byte gave an empty string")};
  <0
};
