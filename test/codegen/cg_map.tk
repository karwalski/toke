(* 123.6: map codegen — get/set/contains/len/keys on str- and i64-keyed maps,
 * value semantics (127.55: a set never changes another binding), a map passed
 * to and returned from a user function (the 127.108 path: a copying setter
 * there, the in-place one on the local accumulator), and growth past the
 * initial table.  A map has no values() (E4036, errors.md), so values are
 * read back through keys().  Expected values are hand-derived. *)
m=cgmap;
i=io:std.io;
i=s:std.str;
f=ck(n:str;got:i64;want:i64):i64{
  if(got==want){io.println("ok \(n)")}el{io.println("FAIL \(n): got \(got) want \(want)")};
  <0
};
f=cs(n:str;got:str;want:str):i64{
  if(got==want){io.println("ok \(n)")}el{io.println("FAIL \(n): got [\(got)] want [\(want)]")};
  <0
};
f=total(m:@(str:i64)):i64{
  let ks=m.keys();
  let t=mut.0;
  lp(let i=0;i<ks.len as i64;i=i+1){ t=t+m.getor(ks.get(i);0); };
  <t
};
f=addone(m:@(str:i64);k:str):@(str:i64){ <m.set(k;m.getor(k;0)+1) };
f=main():i64{
  let m=mut.@("a":1;"b":2);
  ck("len";m.len as i64;2);
  ck("get";m.getor("a";0)+m.getor("b";0);3);
  ck("get miss is 0";m.getor("q";0);0);
  let ha:bool=m.contains("a");
  let hq:bool=m.contains("q");
  cs("contains";"\(ha) \(hq)";"true false");
  m=m.set("c";3);
  m=m.set("a";10);
  ck("set new and overwrite len";m.len as i64;3);
  ck("overwritten value";m.getor("a";0);10);
  cs("keys keep insertion order";s.join(",";m.keys());"a,b,c");
  let snap=m;
  m=m.set("d";4);
  let sd:bool=snap.contains("d");
  cs("value semantics: snapshot unchanged";"\(snap.len) \(sd)";"3 false");
  ck("sum of values via keys";total(m);19);
  let m2=addone(m;"a");
  cs("user fn returns a new map, caller's is intact";"\(mt m2.get("a"){$ok:v v;$err:e 0}) \(mt m.get("a"){$ok:v v;$err:e 0})";"11 10");
  let im=mut.@(1:"one";2:"two");
  im=im.set(3;"three");
  cs("i64 keys";"\(mt im.get(1){$ok:v v;$err:e ""}) \(mt im.get(3){$ok:v v;$err:e ""}) \(im.len)";"one three 3");
  let acc=mut.@("x":0);
  lp(let i=0;i<100;i=i+1){ acc=acc.set("x";acc.getor("x";0)+i); acc=addone(acc;"n"); };
  cs("accumulator through a user fn";"\(mt acc.get("x"){$ok:v v;$err:e 0}) \(mt acc.get("n"){$ok:v v;$err:e 0}) \(acc.len)";"4950 100 2");
  let big=mut.@("k0":0);
  lp(let i=1;i<300;i=i+1){ big=big.set("k\(i)";i); };
  ck("growth keeps every key";big.len as i64;300);
  ck("growth keeps values";big.getor("k299";0)+big.getor("k150";0);449);
  <0
};
