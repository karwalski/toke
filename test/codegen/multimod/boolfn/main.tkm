(* 123.6 multi-module certificate (a witness until 127.217 fixed it): a bool
 * returned by a function in ANOTHER module interpolated as 1/0, while the same
 * function declared in this module rendered true/false (127.94).  Expected
 * output below is the correct one. *)
m=cgmm.boolmain;
i=io:std.io;
i=p:cgmm.pred;
f=local(n:i64):bool{<n>100};
f=cs(n:str;got:str;want:str):i64{
  if(got==want){io.println("ok \(n)")}el{io.println("FAIL \(n): got [\(got)] want [\(want)]")};
  <0
};
f=main():i64{
  cs("same-module bool fn";"\(local(500)) \(local(5))";"true false");
  cs("cross-module bool fn";"\(p.isbig(500)) \(p.isbig(5)) \(p.always())";"true false true");
  <0
};
