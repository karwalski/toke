(* 123.6 multi-module case, module 1 of 3: a struct type, a sum-type error
 * and a fallible function, all used from the two modules that import it. *)
m=cgmm.geom;
t=$pt{x:i64;y:i64;label:str};
t=$gerr{$neg:i64;$far:str};
f=mk(x:i64;y:i64):$pt{<$pt{x:x;y:y;label:"p\(x),\(y)"}};
f=dist2(a:$pt;b:$pt):i64{<(a.x-b.x)*(a.x-b.x)+(a.y-b.y)*(a.y-b.y)};
f=checked(a:$pt):$pt!$gerr{
  if(a.x<0){<$gerr{$neg:a.x}};
  if(a.x>1000){<$gerr{$far:a.label}};
  <a
};
f=names(ps:@($pt)):@str{
  let out=mut.@($str);
  lp(let i=0;i<ps.len as i64;i=i+1){ out=out.append(ps.get(i).label); };
  <out
};
