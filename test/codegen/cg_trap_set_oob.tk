(* 123.6 WITNESS (quarantined; new defect found by 123.6): ADR-0012 (a)
 * "converge the silent guards to the same trap" — `.set` out of range must
 * trap RT003 like `.get` does (ADR-0012 trap table: RT003 is emitted at
 * NODE_INDEX_EXPR AND `.set`).  Today `a.set(5;v)` and `a.set(-1;v)` on a
 * 2-element array return the array unchanged and the program carries on.
 * expect-exit: 1
 * expect-stderr: RT003: index 5 out of bounds for length 2 *)
m=cgtrapsetoob;
i=io:std.io;
f=idx(n:i64):i64{<n+4};
f=main():i64{
  let a=mut.@(1;2);
  a=a.set(1;9);
  io.println("in range \(a.get(1))");
  a=a.set(idx(1);7);
  io.println("FAIL .set past the end did not trap (len \(a.len))");
  <0
};
