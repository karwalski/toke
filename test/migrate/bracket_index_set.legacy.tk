M=brset;
F=main():i64{
  let arr=mut.[5;3;1];
  let n=arr.len;
  lp(let i=0;i<n;i=i+1){
    lp(let j=0;j<n-1;j=j+1){
      if(arr[j]>arr[j+1]){let tmp=arr[j];arr[j]=arr[j+1];arr[j+1]=tmp;};
    };
  };
  let grid=mut.[[0;0];[0;0]];
  grid[1][0]=arr[0]+1;
  if(arr[0]=1){arr[2]=arr[2]*2};
  <arr[0]+grid[1][0]
};
