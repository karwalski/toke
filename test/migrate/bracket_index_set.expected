m=brset;
f=main():i64{
  let arr=mut.@(5;3;1);
  let n=arr.len;
  lp(let i=0;i<n;i=i+1){
    lp(let j=0;j<n-1;j=j+1){
      if(arr.get(j)>arr.get(j+1)){let tmp=arr.get(j);arr.set(j;arr.get(j+1));arr.set(j+1;tmp);};
    };
  };
  let grid=mut.@(@(0;0);@(0;0));
  grid.get(1).set(0;arr.get(0)+1);
  if(arr.get(0)==1){arr.set(2;arr.get(2)*2)};
  <arr.get(0)+grid.get(1).get(0)
};
