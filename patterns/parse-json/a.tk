m=main;
i=io:std.io;
i=s:std.str;
i=env:std.env;
i=json:std.json;
f=pat(src:str):i64{
  let d=mt json.dec(src) {$ok:v v;$err:e <-1};
  let a=mt json.i64(d;"a") {$ok:v v;$err:e <-1};
  let b=mt json.str(d;"b") {$ok:v v;$err:e <-1};
  <a+s.len(b)
};
f=main():i64{
  let n=env.getint("PAT_N";1000);
  let t=mut.0;
  lp(let i=0;i<n;i=i+1){
    t=t+pat("{\"a\":\(i+1),\"b\":\"x\(i%7)\"}")
  };
  io.println("t=\(t)");
  <0
};
