i=env:std.env;
f=isev(x:i64):bool{<x%2==0};
f=add(a:i64;b:i64):i64{<a+b};
f=addev(a:i64;x:i64):i64{<if(x%2==0){a+x}el{a}};
f=pat(xs:@i64):i64{
  <xs.filter(&isev).reduce(0;&add)
};
