m=main;
i=io:std.io;
i=s:std.str;
i=env:std.env;
f=pat(xs:@i64):i64{
  lp(let i=0;i<xs.len;i=i+1){
    lp(let j=i+1;j<xs.len;j=j+1){
      if(xs.get(i)+xs.get(j)==1985){<i*xs.len+j}
    }
  };
  <-1
};
f=main():i64{
  let n=env.getint("PAT_N";1000);
  let xs=mut.@();
  lp(let i=0;i<n;i=i+1){xs=xs.append((i*7)%1000)};
  io.println("t=\(pat(xs))");
  <0
};
