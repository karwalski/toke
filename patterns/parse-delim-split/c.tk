m=main;
i=io:std.io;
i=s:std.str;
i=env:std.env;
f=pat(line:str):@str{
  let r=mut.@();
  let st=mut.0;
  let n=s.len(line);
  lp(let i=0;i<n;i=i+1){
    if(s.charcode(line;i)==44){r=r.append(s.slice(line;st;i));st=i+1}
  };
  <r.append(s.slice(line;st;n))
};
f=main():i64{
  let n=env.getint("PAT_N";1000);
  let t=mut.0;
  lp(let i=0;i<n;i=i+1){
    let fs=pat("ab,cde,\(i),f");
    t=t+fs.len*100;
    lp(let j=0;j<fs.len;j=j+1){t=t+s.len(fs.get(j))}
  };
  io.println("t=\(t)");
  <0
};
