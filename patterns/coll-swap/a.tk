m=main;
i=io:std.io;
i=s:std.str;
i=env:std.env;
f=pat(xs:@i64):@i64{
  let r=mut.xs;
  let n=xs.len;
  lp(let i=0;i<n-1;i=i+2){
    let t=r.get(i);
    r=r.set(i;r.get(i+1));
    r=r.set(i+1;t)
  };
  <r
};
f=main():i64{
  let n=env.getint("PAT_N";1000);
  let xs=mut.@();
  lp(let i=0;i<n;i=i+1){xs=xs.append((i*7)%1000)};
  let r=pat(xs);
  let t=mut.0;
  lp(let i=0;i<r.len;i=i+1){t=(t*31+r.get(i))%1000000007};
  io.println("len=\(r.len) t=\(t)");
  <0
};
