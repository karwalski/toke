i=env:std.env;
f=big(x:i64):bool{<x>990};
f=pat(xs:@i64):i64{
  lp(let i=0;i<xs.len;i=i+1){
    if(xs.get(i)>990){<xs.get(i)}
  };
  <-1
};
f=main():i64{
  let n=env.getint("PAT_N";1000);
  let xs=mut.@();
  lp(let i=0;i<n;i=i+1){xs=xs.append((i*7)%1000)};
  io.println("t=\(pat(xs))");
