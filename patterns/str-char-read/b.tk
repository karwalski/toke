m=main;
i=io:std.io;
i=s:std.str;
i=env:std.env;
f=pat(line:str):i64{
  let c=mut.0;
  lp(let i=0;i<s.len(line);i=i+1){if((mt line.slice(i;i+1){$ok:v v;$err:e ""})==","){c=c+1}};
  <c
};
f=main():i64{
  let n=env.getint("PAT_N";1000);
  let t=mut.0;
  lp(let i=0;i<n;i=i+1){t=t+pat("ab,cde,\(i),f,gh")*10+i%7};
  io.println("t=\(t)");
  <0
};
