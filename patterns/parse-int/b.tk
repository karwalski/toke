m=main;
i=io:std.io;
i=s:std.str;
i=env:std.env;
f=pat(txt:str):i64{
  let n=s.len(txt);
  if(n==0){<-1};
  let v=mut.0;
  lp(let i=0;i<n;i=i+1){
    let c=s.charcode(txt;i);
    if(c<48||c>57){<-1};
    v=v*10+c-48
  };
  <v
};
f=main():i64{
  let n=env.getint("PAT_N";1000);
  let t=mut.0;
  lp(let i=0;i<n;i=i+1){t=t+pat("\(i*7)")+pat("x\(i)")};
  io.println("t=\(t)");
  <0
};
