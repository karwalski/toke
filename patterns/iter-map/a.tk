m=main;
i=io:std.io;
i=s:std.str;
i=env:std.env;
f=dbl(x:i64):i64{<x*2};
f=pat(xs:@i64):@i64{
  <xs.map(&dbl)
};
f=main():i64{
  let n=env.getint("PAT_N";1000);
  let xs=mut.@();
  lp(let i=0;i<n;i=i+1){xs=xs.append((i*7)%1000)};
  let r=pat(xs);
  let t=mut.0;
  lp(let i=0;i<r.len;i=i+1){t=t+r.get(i)};
  io.println("len=\(r.len) t=\(t)");
  <0
};
