m=ud;
i=io:std.io;

i=s:std.str;

i=enc:std.encoding;

f=tochar(n:$i64):$str {
  if (n==32) {
    <" "
  };
  if (n==33) {
    <"!"
  };
  if (n==34) {
    <"\""
  };
  if (n==35) {
    <"#"
  };
  if (n==36) {
    <"$"
  };
  if (n==37) {
    <"%"
  };
  if (n==38) {
    <"&"
  };
  if (n==39) {
    <"'"
  };
  if (n==40) {
    <"("
  };
  if (n==41) {
    <")"
  };
  if (n==42) {
    <"*"
  };
  if (n==43) {
    <"+"
  };
  if (n==44) {
    <","
  };
  if (n==45) {
    <"-"
  };
  if (n==46) {
    <"."
  };
  if (n==47) {
    <"/"
  };
  if (n==58) {
    <":"
  };
  if (n==59) {
    <";"
  };
  if (n==60) {
    <"<"
  };
  if (n==61) {
    <"="
  };
  if (n==62) {
    <">"
  };
  if (n==63) {
    <"?"
  };
  if (n==64) {
    <"@"
  };
  if (n==91) {
    <"["
  };
  if (n==93) {
    <"]"
  };
  if (n==123) {
    <"{"
  };
  if (n==125) {
    <"}"
  };
  if (n==126) {
    <"~"
  };
  <""
};

f=main():$i64 {
  let line=io.readln();
  let out=s.builder();
  let i=mut.0;
  lp (i<s.len(line)) {
    let c=s.slice(line; i; i+1);
    if (c=="%"&&i+2<s.len(line)) {
      let n=mt enc.hexdecode(s.slice(line; i+1; i+3)) {$ok:v v.get(0);$err:e 0};
      s.add(out; tochar(n));
      i=i+3
    } el {
      s.add(out; c);
      i=i+1
    }
  };
  io.println(s.build(out));
  <0
}
