m=pnl;i=io:std.io;i=s:std.str;
f=main():$i64{
  let rev=mut.0.0;
  let exp=mut.0.0;
  lp(true){
    let line=io.readln();
    if(io.eof()){br};
    let t=s.trim(line);
    if(s.len(t)==0){br};
    let parts=s.split(t;" ");
    if(parts.len()>=3){
      let typ=parts.get(0);
      let amt=s.tofloat(parts.get(2));
      if(typ=="REVENUE"){rev=rev+amt}el if(typ=="EXPENSE"){exp=exp+amt}
    }
  };
  let net=rev-exp;
  io.println("REVENUE: \(s.format(rev;"%.2f"))");
  io.println("EXPENSES: \(s.format(exp;"%.2f"))");
  if(net<0.0){io.println("NET LOSS: \(s.format(0.0-net;"%.2f"))")}el{io.println("NET PROFIT: \(s.format(net;"%.2f"))")};
  <0
}
