m=healthcheck;i=io:std.io;i=s:std.str;f=main():$i64{let url=s.trim(io.readln());let line2=s.trim(io.readln());let condition=s.trim(io.readln());let status=mut.0;if(s.contains(url;"status/")){let parts=s.split(url;"status/");if(parts.len()>=2){status=s.toint(s.trim(parts.get(1)))}}el{status=200};let expected=mut.0;if(s.contains(condition;"=")){let cparts=s.split(condition;"=");if(cparts.len()>=2){expected=s.toint(s.trim(cparts.get(1)))}}el{expected=s.toint(condition)};if(status==expected){io.println("PASS")}el{io.println("FAIL")};<0}
