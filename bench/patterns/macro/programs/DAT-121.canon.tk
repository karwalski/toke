m=phonetic;
i=io:std.io;
i=s:std.str;
f=byteat(x:$str;i:i64):i64{ let b=s.bytes(x); <b.get(i as u64) as i64 };
f=charat(x:$str;i:i64):$str{
  let r=mt s.slice(x;i as u64;(i+1) as u64){ $ok:v v; $err:e "" };
  <s.concat(r;"")
};
f=isvowel(c:i64):bool{
  <c==65||c==69||c==73||c==79||c==85||c==89
};
f=isalpha(c:i64):bool{
  <c>=65&&c<=90
};
f=soundexcode(c:i64):i64{
  <if(c==66||c==70||c==80||c==86){1}el if(c==67||c==71||c==74||c==75||c==81||c==83||c==88||c==90){2}el if(c==68||c==84){3}el if(c==76){4}el if(c==77||c==78){5}el if(c==82){6}el{0}
};
f=soundex(word:$str):$str{
  let u=s.upper(word);
  let n=s.len(u) as i64;
  let first=charat(u;0);
  let result=mut.first;
  let prev=mut.soundexcode(byteat(u;0));
  let count=mut.1;
  lp(let i=1;i<n;i=i+1){
    if(count<4){
      let c=byteat(u;i);
      let code=soundexcode(c);
      if(code>0){
        if(code!=prev){
          result=s.concat(result;"\(code)");
          count=count+1;
        };
        prev=code;
      }el if(c!=72&&c!=87){
        prev=0;
      };
    };
  };
  lp(true){
    if(s.len(result) as i64>=4){br};
    result=s.concat(result;"0");
  };
  let out=mt s.slice(result;0 as u64;4 as u64){ $ok:v v; $err:e "" };
  <s.concat(out;"")
};
f=lettersonly(word:$str):$str{
  let u=s.upper(word);
  let n=s.len(u) as i64;
  let out=s.builder();
  lp(let i=0;i<n;i=i+1){
    let c=byteat(u;i);
    if(isalpha(c)){
      s.add(out;charat(u;i));
    };
  };
  <s.build(out)
};
f=metaphone(word:$str):$str{
  let w=lettersonly(word);
  let n=s.len(w) as i64;
  let out=s.builder();
  let i=mut.0;
  lp(true){
    if(i>=n){br};
    let c=byteat(w;i);
    let nxt=if(i+1<n){byteat(w;i+1)}el{0};
    let prv=if(i>0){byteat(w;i-1)}el{0};
    if(c==prv&&c!=67){
      i=i+1;
    }el if(isvowel(c)){
      if(i==0){ s.add(out;charat(w;i)); };
      i=i+1;
    }el if(c==83){
      if(nxt==72){
        s.add(out;"X");
        i=i+2;
      }el{
        s.add(out;"S");
        i=i+1;
      };
    }el if(c==84){
      if(nxt==72){
        s.add(out;"0");
        i=i+2;
      }el{
        s.add(out;"T");
        i=i+1;
      };
    }el if(c==72){
      if(!isvowel(prv)||isvowel(nxt)){
        s.add(out;"H");
      };
      i=i+1;
    }el{
      s.add(out;charat(w;i));
      i=i+1;
    };
  };
  <s.build(out)
};
f=dmetaphone(word:$str):$str{
  let w=lettersonly(word);
  let n=s.len(w) as i64;
  let out=s.builder();
  let i=mut.0;
  lp(true){
    if(i>=n){br};
    let c=byteat(w;i);
    let nxt=if(i+1<n){byteat(w;i+1)}el{0};
    let prv=if(i>0){byteat(w;i-1)}el{0};
    if(c==prv&&c!=67){
      i=i+1;
    }el if(isvowel(c)){
      if(i==0){ s.add(out;charat(w;i)); };
      i=i+1;
    }el if(c==83){
      if(nxt==72){
        s.add(out;"X");
        i=i+2;
      }el{
        s.add(out;"S");
        i=i+1;
      };
    }el if(c==84){
      if(nxt==72){
        let after=if(i+2<n){byteat(w;i+2)}el{0};
        let atend=i+2>=n||(after==69&&i+3>=n);
        if(!atend){
          s.add(out;"0");
        };
        i=i+2;
      }el{
        s.add(out;"T");
        i=i+1;
      };
    }el if(c==72){
      if(!isvowel(prv)||isvowel(nxt)){
        s.add(out;"H");
      };
      i=i+1;
    }el{
      s.add(out;charat(w;i));
      i=i+1;
    };
  };
  <s.build(out)
};
f=tabchar():$str{
  let bytes=mut.@();
  bytes=bytes.push(9 as byte);
  <mt s.frombytes(bytes){ $ok:v v; $err:e " " }
};
f=main():i64{
  let t=tabchar();
  lp(true){
    let line=io.readln();
    if(io.eof()){br};
    let w=s.trim(line);
    if(s.len(w)>0 as u64){
      let sx=soundex(w);
      let mp=metaphone(w);
      let dm=dmetaphone(w);
      io.println("\(w)\(t)\(sx)\(t)\(mp)\(t)\(dm)");
    };
  };
  <0
};
