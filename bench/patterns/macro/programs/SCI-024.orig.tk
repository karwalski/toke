m=bubblesort;i=io:std.io;i=s:std.str;f=main():$i64{let line=s.trim(io.readln());let parts=s.split(line;" ");let arr=mut.@($i64);lp(let i=0;i<parts.len();i=i+1){let tok=s.trim(parts.get(i));if(s.len(tok)>0){arr=arr+@(s.toint(tok))}};let n=arr.len();let cmp=mut.0;let swp=mut.0;lp(let pass=0;pass<n-1;pass=pass+1){lp(let idx=0;idx<n-pass-1;idx=idx+1){cmp=cmp+1;if(arr.get(idx)>arr.get(idx+1)){swp=swp+1;let tmp=arr.get(idx);arr=arr.set(idx;arr.get(idx+1));arr=arr.set(idx+1;tmp)}}};let out=mut."Sorted:";lp(let i=0;i<n;i=i+1){out=s.concat(out;" ");out=s.concat(out;s.fromint(arr.get(i)))};io.println(out);io.println(s.concat("Comparisons: ";s.fromint(cmp)));io.println(s.concat("Swaps: ";s.fromint(swp)));<0}
