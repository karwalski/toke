m=rlp;
i=io:std.io;

i=s:std.str;

f=hexd(n:$i64):$str {
  if (n<10) {
    <s.fromint(n)
  };
  if (n==10) {
    <"a"
  };
  if (n==11) {
    <"b"
  };
  if (n==12) {
    <"c"
  };
  if (n==13) {
    <"d"
  };
  if (n==14) {
    <"e"
  };
  <"f"
};

f=hex2(n:$i64):$str {
  let hi=n/16;
  <"\(hexd(hi))\(hexd(n-hi*16))"
};

f=encstr(str:$str):$str {
  let n=s.len(str);
  if (n==0) {
    <"80"
  };
  if (n==1) {
    let c=s.charcode(s.slice(str; 0; 1); 0);
    if (c<128) {
      <hex2(c)
    }
  };
  let b=s.builder();
  let i=mut.0;
  lp (i<n) {
    s.add(b; hex2(s.charcode(s.slice(str; i; i+1); 0)));
    i=i+1
  };
  let body=s.build(b);
  if (n<=55) {
    <"\(hex2(128+n))\(body)"
  };
  <"error\(body)"
};

f=main():$i64 {
  let line=s.trim(io.readln());
  let n=s.len(line);
  if (s.startswith(line; "\"")) {
    io.println(encstr(s.slice(line; 1; n-1)));
    <0
  };
  if (s.startswith(line; "[")) {
    let inner=s.slice(line; 1; n-1);
    let items=mut.@();
    let i=mut.0;
    let cur=mut."";
    let inq=mut.false;
    lp (i<s.len(inner)) {
      let ch=s.slice(inner; i; i+1);
      if (ch=="\"") {
        if (inq) {
          items=items.append(cur);
          cur="";
          inq=false
        } el {
          inq=true
        }
      } el if (inq) {
        cur=s.concat(cur; ch)
      };
      i=i+1
    };
    let b=s.builder();
    let j=mut.0;
    lp (j<items.len()) {
      s.add(b; encstr(items.get(j)));
      j=j+1
    };
    let body=s.build(b);
    let blen=s.len(body)/2;
    if (blen<=55) {
      io.println("\(hex2(192+blen))\(body)");
      <0
    }
  };
  io.println("80");
  <0
}
