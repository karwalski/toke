              };
              i=i+1;
            }el{
              out=s.concat(out;charat(w;i));
              i=i+1;
            };
          };
        };
      };
    };
  };
  <out
};
f=tabchar():$str{
  let bytes=mut.@();
  bytes=bytes.push(9 as byte);
  <mt s.frombytes(bytes){ $ok:v v; $err:e " " }
};
f=main():i64{
  let t=tabchar();
  lp(true){
    let line=io.readln();
    if(io.eof()){br};
    let w=s.trim(line);
    if(s.len(w)>0 as u64){
      let sx=soundex(w);
      let mp=metaphone(w);
      let dm=dmetaphone(w);
      let out=mut.w;
      out=s.concat(out;t);
      out=s.concat(out;sx);
      out=s.concat(out;t);
      out=s.concat(out;mp);
      out=s.concat(out;t);
      out=s.concat(out;dm);
      io.println(out);
    };
  };
  <0
};
