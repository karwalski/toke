            out=s.concat(out;"X");
            i=i+2;
          }el{
            out=s.concat(out;"S");
            i=i+1;
          };
        }el{
          if(c==84){
            if(nxt==72){
              let after=mut.0;
              if(i+2<n){ after=byteat(w;i+2); };
              let atend=mut.false;
              if(i+2>=n){ atend=true; };
              if(after==69){
                if(i+3>=n){ atend=true; };
              };
              if(!(atend)){
                out=s.concat(out;"0");
              };
              i=i+2;
            }el{
              out=s.concat(out;"T");
              i=i+1;
            };
          }el{
            if(c==72){
              let prvvowel=isvowel(prv);
              let nxtvowel=isvowel(nxt);
              if(prvvowel){
