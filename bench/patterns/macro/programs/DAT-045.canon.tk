m=checksum;i=io:std.io;i=s:std.str;
f=crc32(line:$str):$i64{
  let n=s.len(line);
  let crc=mut.4294967295;
  let i=mut.0;
  lp(i<n){
    let byte=s.charat(line;i);
    crc=(crc^byte)&4294967295;
    let k=mut.0;
    lp(k<8){
      crc=(if(crc&1==1){(crc>>1)^3988292384}el{crc>>1})&4294967295;
      k=k+1
    };
    i=i+1
  };
  <(crc^4294967295)&4294967295
};
f=hex8(val:$i64):$str{
  let digits="0123456789abcdef";
  let out=s.builder();
  let shift=mut.28;
  lp(shift>=0){
    let nib=(val>>shift)&15;
    s.add(out;s.slice(digits;nib;nib+1));
    shift=shift-4
  };
  <s.build(out)
};
f=main():$i64{
  let line=mut.io.readln();
  let first=mut.1;
  lp(1==1){
    if(io.eof()==1){
      if(first==1){
        io.println(s.concat("00000000";"\t"))
      };
      br
    }el{
      let hx=hex8(crc32(line));
      io.println("\(hx)\t\(line)");
      first=0;
      line=io.readln()
    }
  };
  <0
};
