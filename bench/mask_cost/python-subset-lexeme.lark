simples: small (WS? ";" WS? small)* (WS? ";")?
small: JUMP
    | "return" (WS exprlist)?
    | "raise" (WS test (WS "from" WS test)?)?
    | "import" WS dotted (WS "as" WS NAME)? (WS? "," WS? dotted (WS "as" WS NAME)?)*
    | "from" WS dotted WS "import" WS ("*" | NAME (WS "as" WS NAME)? (WS? "," WS? NAME (WS "as" WS NAME)?)*)
    | ("global" | "nonlocal") WS NAME (WS? "," WS? NAME)*
    | "del" WS targets
    | "assert" WS test (WS? "," WS? test)?
    | (targets WS? "=" WS?)+ exprlist
    | single WS? (AUGOP WS? exprlist | ":" WS? test (WS? "=" WS? exprlist)?)
    | exprlist
dotted: NAME (WS? "." WS? NAME)*
targets: target (WS? "," WS? target)* (WS? ",")?
target: single | "(" WS? targets WS? ")" | "[" WS? targets WS? "]"
tprimary: atom trailer* (WS? "." WS? NAME | WS? "[" WS? subs WS? "]")
witem: test (WS "as" WS target)?
params: pnd (WS? "," WS? pnd)* (WS? "," WS? pdf)* (WS? "," WS? ptail)? (WS? ",")? | pdf (WS? "," WS? pdf)* (WS? "," WS? ptail)? (WS? ",")? | ptail (WS? ",")?
pnd: NAME (WS? ":" WS? test)?
pdf: NAME (WS? ":" WS? test)? WS? "=" WS? test
ptail: "*" WS? NAME (WS? ":" WS? test)? (WS? "," WS? (pdf | pnd))* (WS? "," WS? "**" WS? NAME (WS? ":" WS? test)?)? | "**" WS? NAME (WS? ":" WS? test)?
lparams: NAME (WS? "," WS? NAME)* (WS? "," WS? lpdf)* (WS? ",")? | lpdf (WS? "," WS? lpdf)* (WS? ",")?
lpdf: NAME WS? "=" WS? test
args: cargs | test comp
cargs: parg (WS? "," WS? parg)* (WS? "," WS? karg)* (WS? ",")? | karg (WS? "," WS? karg)* (WS? ",")?
parg: test | "*" WS? test
karg: NAME WS? "=" WS? test | "**" WS? test
test: ternary | lambdef
lambdef: "lambda" (WS lparams)? WS? ":" WS? test
exprlist: test (WS? "," WS? test)* (WS? ",")?
cmpop: WS? CMPSYM WS? | WS ("in" | "not" WS "in" | "is" | "is" WS "not") WS
ternary: ortest (WS "if" WS ortest WS "else" WS test)?
ortest: nottest (boolop nottest)*
nottest: "not" WS nottest | comparison
comparison: bor (cmpop bor)*
bor: factor (binop factor)*
factor: /[\-+~]/ WS? factor | primary
primary: atom trailer* | ATOMN
ternary_nb: ortest_nb (WS "if" WS ortest WS "else" WS test)?
ortest_nb: nottest_nb (boolop nottest)*
nottest_nb: "not" WS nottest | comparison_nb
comparison_nb: bor_nb (cmpop bor)*
bor_nb: factor_nb (binop factor)*
factor_nb: /[\-+~]/ WS? factor | primary_nb
primary_nb: atomnb trailer* | ATOMN
trailer: WS? "(" WS? (args WS?)? ")" | WS? "[" WS? subs WS? "]" | WS? "." WS? NAME
subs: sub (WS? "," WS? sub)* (WS? ",")?
sub: test | (ternary WS?)? ":" (WS? ternary)? (WS? ":" (WS? ternary)?)?
atom: atomnb | "{" WS? (dictitems WS? | exprlist WS? | kv comp WS? | test comp WS?)? "}"
atomnb: NAME
    | strings
    | KWCONST
    | "(" WS? (exprlist WS? | test comp WS?)? ")"
    | "[" WS? (exprlist WS? | test comp WS?)? "]"
dictitems: kv (WS? "," WS? kv)* (WS? ",")?
kv: ternary WS? ":" WS? test | "**" WS? bor
comp: (WS "for" WS targets WS "in" WS ortest (WS "if" WS ortest)*)+
pattern: orpat (WS "as" WS CAPNAME)?
orpat: closedpat (WS? "|" WS? closedpat)*
closedpat: "-"? NUMBER
    | STR
    | STRQ
    | "None"
    | "True"
    | "False"
    | CAPNAME
    | "_"
    | NAME (WS? "." WS? NAME)+
    | "(" WS? pattern WS? ")"
    | "(" WS? ")"
    | "(" WS? pattern WS? "," (WS? pattern (WS? "," WS? pattern)* (WS? ",")?)? WS? ")"
    | "[" WS? (pattern (WS? "," WS? pattern)* (WS? ",")? WS?)? "]"
    | NAME (WS? "." WS? NAME)* WS? "(" WS? (classargs WS?)? ")"
classargs: pattern (WS? "," WS? pattern)* (WS? "," WS? kwpat)* (WS? ",")? | kwpat (WS? "," WS? kwpat)* (WS? ",")?
kwpat: NAME WS? "=" WS? pattern
strings: string (WS string)*
string: PSTR | fstr | fstrq
fstr: "f\"" (FCHUNK | "{{" | "}}" | field)* "\""
field: "{" (WS ternary | ternary_nb) WS? FSPEC? "}"
fstrq: "f'" (FCHUNKQ | "{{" | "}}" | fieldq)* "'"
fieldq: "{" (WS ternary | ternary_nb) WS? FSPECQ? "}"
binop: WS? BINSYM WS?
boolop: WS ("or" | "and") WS
single: NAME | tprimary

// lexemes: the lexical rules, inlined to regular expressions
